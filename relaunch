#!/usr/bin/env bash
# omarchy-relaunch bar widget engine shim. The engine is the root-owned Rust
# binary the system package installs; this copy on PATH and in the plugin
# folder only hands over to it, so a user-writable file never decides what the
# engine does.
ENGINE=/usr/lib/omarchy-relaunch/relaunch
if [[ ! -x "$ENGINE" ]]; then
  printf 'relaunch: the engine is not installed (%s); install the omarchy-relaunch package\n' "$ENGINE" >&2
  exit 127
fi
exec "$ENGINE" "$@"
