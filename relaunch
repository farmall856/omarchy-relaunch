#!/usr/bin/env bash
# relaunch — engine for the omarchy-relaunch bar widget.
# Inventories running windows and existing Hyprland startup apps, then
# generates workspace-pin rules. App launches happen from `relaunch boot`
# (a hidden autostart hook), so this script can skip or disable itself.
set -euo pipefail

HYPRCTL="${HYPRCTL:-hyprctl}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

config_dir() {
  if [[ -n "${RELAUNCH_CONFIG_DIR:-}" ]]; then
    printf '%s\n' "$RELAUNCH_CONFIG_DIR"
    return
  fi
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-relaunch"
}

config_path() { printf '%s\n' "$(config_dir)/config.json"; }
overrides_path() { printf '%s\n' "$(config_dir)/overrides.json"; }
snippet_path() { printf '%s\n' "$(config_dir)/relaunch.conf"; }
lua_path() { printf '%s\n' "$(config_dir)/relaunch.lua"; }
disabled_path() { printf '%s\n' "$(config_dir)/disabled"; }
skip_path() { printf '%s\n' "$(config_dir)/skip-once"; }
last_boot_log_path() { printf '%s\n' "$(config_dir)/last-boot.log"; }
last_boot_json_path() { printf '%s\n' "$(config_dir)/last-boot.json"; }
last_session_path() { printf '%s\n' "$(config_dir)/last-session.json"; }
snapshot_unit_path() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omarchy-relaunch-snapshot.service"
}

autostart_path() {
  printf '%s\n' "${RELAUNCH_AUTOSTART:-$HOME/.config/hypr/autostart.lua}"
}

hyprland_lua_path() {
  printf '%s\n' "${RELAUNCH_HYPRLAND_LUA:-$HOME/.config/hypr/hyprland.lua}"
}

plugin_dir() {
  printf '%s\n' "${RELAUNCH_PLUGIN_DIR:-$HOME/.config/omarchy/plugins/io.github.laytonf.relaunch}"
}

json_out=false

has_json_flag() {
  local a
  for a in "$@"; do
    [[ "$a" == --json ]] && return 0
  done
  return 1
}

die() {
  local msg="$1"
  if $json_out; then
    jq -n --arg error "$msg" '{ok: false, error: $error}'
  else
    printf 'error: %s\n' "$msg" >&2
  fi
  exit 1
}

need_jq() {
  command -v jq >/dev/null 2>&1 || die "jq not found (required; ships with Omarchy)"
}

# Shared jq helpers. Launch commands are resolved in bash (terminal wrap,
# overrides.json, .desktop, cmdline). guess_exec is the last-resort class fold.
jq_lib='
def guess_exec:
  ascii_downcase;

def known_exec_sources:
  ["terminal", "overrides-table", "desktop-file", "cmdline", "guess"];

def normalize_exec_source:
  if (known_exec_sources | index(.)) != null then . else "" end;

def match_class:
  if ((.initialClass // "") != "") then .initialClass else (.class // "") end;

def regex_escape:
  gsub("\\\\"; "\\\\")
  | gsub("\\."; "\\.")
  | gsub("\\+"; "\\+")
  | gsub("\\*"; "\\*")
  | gsub("\\?"; "\\?")
  | gsub("\\("; "\\(")
  | gsub("\\)"; "\\)")
  | gsub("\\["; "\\[")
  | gsub("\\]"; "\\]")
  | gsub("\\{"; "\\{")
  | gsub("\\}"; "\\}")
  | gsub("\\^"; "\\^")
  | gsub("\\$"; "\\$")
  | gsub("\\|"; "\\|");

# Hyprland regex backslashes must be doubled again for Lua "..." strings.
# Otherwise org.omarchy.agent becomes "org\.omarchy" and Lua errors on \o.
def lua_regex:
  regex_escape | gsub("\\\\"; "\\\\") | gsub("\""; "\\\"");

def normalize_entry:
  {
    class: (.class // ""),
    workspace: ((.workspace // 0) | tonumber),
    exec: (.exec // ""),
    execSource: ((.execSource // "") | normalize_exec_source),
    enabled: (.enabled == true),
    # Display only. class stays the identity and the only lookup key, so a
    # wrong label is cosmetic and can never mis-pin a window.
    label: ((.label // "") | tostring),
    startupKeys: ((.startupKeys // []) | map(ascii_downcase))
  }
  + (
      # float is a real boolean: false is a captured fact ("this window was
      # tiled"), not the absence of one. Only a genuinely absent float --
      # a legacy entry, or one added by `import` with no live window to
      # read -- stays absent, and that means "unknown, emit no rule".
      if (.float | type) == "boolean" then {float: .float} else {} end
    );

def load_config:
  {
    staggerSeconds: ((.staggerSeconds // 0) | tonumber),
    ignored: ((.ignored // []) | map(tostring)),
    skipOnce: (.skipOnce == true),
    entries: ((.entries // []) | map(normalize_entry))
  };

def dump_config:
  {
    staggerSeconds: .staggerSeconds,
    ignored: (.ignored // []),
    skipOnce: (.skipOnce == true),
    entries: ([.entries[] | normalize_entry] | sort_by(.workspace, .class))
  };

def capture($clients):
  load_config as $cfg
  | ($cfg.entries) as $old
  | ([ $old[] | {key: .class, value: .} ] | from_entries) as $by0
  | (
      $clients
      | map(. + {match: match_class})
      | map(select(.match != "" and ((.workspace.id // 0) >= 1)))
      | sort_by(.workspace.id, .match)
    ) as $cs
  | reduce $cs[] as $cl (
      {by: $by0, added: 0, updated: 0, order: [$old[].class], seen: {}};
      if .seen[$cl.match] then .
      else
        .seen[$cl.match] = true
        | if .by[$cl.match] then
            # updated counts entries, not fields: one window whose workspace
            # and float both moved is one update, so compare the whole entry
            # once at the end rather than incrementing per assignment.
            (.by[$cl.match]) as $before
            | .by[$cl.match].workspace = $cl.workspace.id
            # Live window state is the authority for float, same as for
            # workspace. Recapture refreshes it rather than preserving it.
            | .by[$cl.match].float = ($cl.floating == true)
            # Same for the display label: recomputed at save time so it
            # self-heals when a .desktop file appears, moves or is renamed.
            # Not for an overrides-table entry though: its exec is the text
            # the user typed and is protected below, so relabelling it from
            # the live hosted command would describe a command it does not
            # run.
            | (if ($cl.relaunchLabel // "") != ""
                  and ((.by[$cl.match].execSource | normalize_exec_source) != "overrides-table")
               then
                 .by[$cl.match].label = $cl.relaunchLabel
               else . end)
            # Same override protection as the label: a user override keeps
            # its typed exec, so correlation keys describing the live hosted
            # command would associate it with a startup line it never runs.
            | (if (($cl.relaunchStartupKeys // []) | length) > 0
                  and ((.by[$cl.match].execSource | normalize_exec_source) != "overrides-table")
               then
                 .by[$cl.match].startupKeys = $cl.relaunchStartupKeys
               else . end)
            | (
                (.by[$cl.match].execSource | normalize_exec_source) as $src
                | (($cl.relaunchExecSource // "") | normalize_exec_source) as $nsrc
                | (($cl.relaunchExec // "") != "")
                  and ($nsrc == "terminal" or $nsrc == "overrides-table" or $nsrc == "desktop-file")
                  and (
                    # A fallback value always yields to a resolved one.
                    $src == "guess" or $src == "cmdline"
                    or ($src == "" and .by[$cl.match].exec == ($cl.match | ascii_downcase))
                    # An engine-derived value re-heals when live resolution
                    # disagrees, so a stale entry written by an older version
                    # cannot survive forever. Only "overrides-table" holds
                    # text the user typed, and it is never overwritten here.
                    or (($src == "terminal" or $src == "desktop-file")
                        and .by[$cl.match].exec != $cl.relaunchExec)
                  )
              ) as $heal
            | if $heal then
                .by[$cl.match].exec = $cl.relaunchExec
                | .by[$cl.match].execSource = $cl.relaunchExecSource
              else . end
            | if .by[$cl.match] != $before then .updated += 1 else . end
          else
            .by[$cl.match] = (
              {
                class: $cl.match,
                workspace: $cl.workspace.id,
                exec: (if ($cl.relaunchExec // "") != "" then $cl.relaunchExec else ($cl.match | guess_exec) end),
                execSource: (
                  if ($cl.relaunchExecSource // "") != "" then $cl.relaunchExecSource
                  elif ($cl.relaunchExec // "") != "" then "guess"
                  else "guess"
                  end
                ),
                enabled: true,
                label: (
                  if ($cl.relaunchLabel // "") != "" then $cl.relaunchLabel
                  else $cl.match end
                ),
                startupKeys: ($cl.relaunchStartupKeys // [])
              }
              + {float: ($cl.floating == true)}
            )
            | .order += [$cl.match]
            | .added += 1
          end
      end
    )
  | {
      staggerSeconds: $cfg.staggerSeconds,
      ignored: $cfg.ignored,
      skipOnce: $cfg.skipOnce,
      entries: [ .order[] as $c | .by[$c] ],
      added, updated
    };

def enabled_entries:
  load_config
  | .entries
  | map(select(.enabled and .class != "" and .workspace > 0))
  | sort_by(.workspace, .class);

def lua_rules:
  enabled_entries
  | map(
      # tile = true alone does NOT beat the Omarchy floating-window tag.
      # Verified: default/hypr/apps/system.lua tags TUI.float +floating-window
      # and floats it via o.window({ tag = "floating-window" }, ...). A later
      # tile = true still came back floating at 875x600; removing the tag first
      # does work. A direct per-class float rule (steam, screensaver) IS beaten
      # by a later tile = true, so only the tag path needs this extra line.
      (if .float == false then
         "o.window({ class = \"^(\(.class | lua_regex))$\" }, { tag = \"-floating-window\" })\n"
       else "" end)
      + "o.window({ class = \"^(\(.class | lua_regex))$\" }, { workspace = \"\(.workspace) silent\""
      + (
          # Omarchy tags TUI.float etc. +floating-window in
          # default/hypr/apps/system.lua, so silence means "float" for those
          # classes. Say tile = true explicitly to bring a tiled window back
          # tiled. relaunch.lua is loaded by hyprland.lua after the Omarchy
          # defaults, so this rule wins. tile is a first-class rule: see
          # default/hypr/apps/browser.lua.
          if .float == true then ", float = true"
          elif .float == false then ", tile = true"
          else "" end
        )
      + " })\n"
    )
  | add // "";
'

load_config_json() {
  local path
  path="$(config_path)"
  if [[ ! -f "$path" ]]; then
    printf '%s\n' '{"staggerSeconds":0,"ignored":[],"entries":[]}'
    return
  fi
  jq -e "$jq_lib"' load_config' "$path" || die "parse config: $path"
}

# The path a write should actually land on. A rename replaces whatever sits
# at the destination, so renaming onto a symlink destroys the link and
# silently disconnects a dotfiles-managed file. Resolve the chain first and
# rename onto the *target*, leaving the user-facing symlink untouched.
#
# The `[[ -L ]]` test is a builtin, so the ordinary regular-file case costs
# nothing; readlink only runs for a path that really is a link.
resolve_write_target() {
  local path="$1" target
  [[ -L "$path" ]] || { printf '%s\n' "$path"; return 0; }
  # -f resolves the whole chain and tolerates a dangling final component, so
  # a symlink pointing at a file that does not exist yet still writes through
  # to the named target. -m is the fallback when an intermediate directory is
  # missing too, which -f refuses.
  target="$(readlink -f -- "$path" 2>/dev/null || true)"
  [[ -n "$target" ]] || target="$(readlink -m -- "$path" 2>/dev/null || true)"
  # Never silently replace a link we cannot resolve.
  [[ -n "$target" ]] || die "cannot resolve symlink, refusing to replace it: $path"
  printf '%s\n' "$target"
}

atomic_write() {
  local dest="$1" real tmp
  real="$(resolve_write_target "$dest")"
  tmp="${real}.tmp"
  mkdir -p "$(dirname "$real")"
  cat >"$tmp"
  mv -f "$tmp" "$real"
}

config_skip_once() {
  local p
  p="$(config_path)"
  [[ -f "$p" ]] && jq -e '.skipOnce == true' "$p" >/dev/null 2>&1
}

boot_gated() {
  [[ -f "$(disabled_path)" || -f "$(skip_path)" ]] && return 0
  config_skip_once
}

set_skip_once() {
  local on="$1" cfg
  mkdir -p "$(config_dir)"
  if [[ "$on" == true ]]; then
    : >"$(skip_path)"
  else
    rm -f "$(skip_path)"
  fi
  cfg="$(load_config_json)"
  cfg="$(jq --argjson on "$on" '.skipOnce = $on' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
}

write_config_from_json() {
  jq "$jq_lib"' dump_config' | atomic_write "$(config_path)"
}

remove_legacy_conf() {
  # Older installs wrote windowrulev2 to relaunch.conf and sourced it from
  # hyprland.conf. Pins now live only in relaunch.lua; drop the leftover
  # file and source line so both install paths stay on one mechanism.
  rm -f "$(snippet_path)" "$(snippet_path).tmp"
  local hypr_conf="${RELAUNCH_HYPR_CONF:-$HOME/.config/hypr/hyprland.conf}" tmp
  [[ -f "$hypr_conf" ]] || return 0
  if grep -qF "source = $(snippet_path)" "$hypr_conf" || grep -qx '# omarchy-relaunch' "$hypr_conf"; then
    tmp="$(mktemp)"
    grep -vF "source = $(snippet_path)" "$hypr_conf" | grep -vx '# omarchy-relaunch' >"$tmp" || true
    mv -f "$tmp" "$hypr_conf"
  fi
}

write_generated() {
  local cfg gated=false
  cfg="$(cat)"
  if boot_gated; then gated=true; fi
  remove_legacy_conf
  {
    cat <<'LUA'
-- Generated by omarchy-relaunch. Do not edit by hand.
-- Regenerated by: relaunch generate
local cfg = os.getenv("XDG_CONFIG_HOME")
if cfg == nil or cfg == "" then
  cfg = os.getenv("HOME") .. "/.config"
end
local dir = cfg .. "/omarchy-relaunch"
local function exists(path)
  local f = io.open(path, "r")
  if f ~= nil then f:close(); return true end
  return false
end
if exists(dir .. "/disabled") or exists(dir .. "/skip-once") then
  return
end
LUA
    if $gated; then
      printf '%s\n' '-- skip/disable armed; relaunch boot restores rules when the flag is cleared'
    else
      jq -r "$jq_lib"' lua_rules' <<<"$cfg"
    fi
  } | atomic_write "$(lua_path)"
}

split_exec_words() {
  # Split an exec string on IFS without pathname expansion.
  local _s="$1"
  local -n _out="$2"
  set -f
  # shellcheck disable=SC2206
  _out=($_s)
  set +f
}

is_relaunch_exec() {
  local exec="$1" token base
  local -a words=()
  [[ "$exec" == *omarchy-relaunch* ]] && return 0
  split_exec_words "$exec" words
  token="${words[0]:-}"
  token="${token##*/}"
  [[ "$token" == relaunch ]] && return 0
  for token in "${words[@]}"; do
    base="${token##*/}"
    [[ "$base" == relaunch ]] && return 0
  done
  return 1
}

is_wrapper_cmd() {
  case "${1##*/}" in
    setsid | env | command | nice | nohup | uwsm-app) return 0 ;;
  esac
  return 1
}

is_terminal_cmd() {
  local b="${1##*/}"
  case "$b" in
    foot | alacritty | kitty | wezterm | wezterm-gui | ghostty | xdg-terminal-exec)
      return 0
      ;;
  esac
  [[ "$b" == omarchy-launch-terminal* ]]
}

is_generic_terminal_class() {
  case "$1" in
    foot | alacritty | kitty | wezterm | wezterm-gui | ghostty | xdg-terminal-exec)
      return 0
      ;;
  esac
  return 1
}

# Join argv into one shell-safe line. /proc preserves argument boundaries that
# a plain "${argv[*]}" join throws away: Omarchy's Disk Usage runs as
# `foot --app-id=TUI.float -e bash -c 'dua i /'`, where `dua i /` is a single
# argument. Flattened and re-split, that becomes `bash -c dua i /`, which runs
# dua with no arguments — it prints and exits, so the window is gone before the
# workspace pin can apply.
quote_argv() {
  local out="" a q
  for a in "$@"; do
    printf -v q '%q' "$a"
    out+="${out:+ }${q}"
  done
  printf '%s' "$out"
}

# Split a shell-quoted exec back into argv, without eval. The stored exec is
# printf %q output, so `bash -c dua\ i\ /` holds "dua i /" as ONE argument.
# Tokenizing the raw string instead yields a leaf of `dua\`, which matches no
# .desktop file. eval would unquote correctly but would also run command
# substitution in a string the user can edit in overrides.json, and this runs
# at save time, not launch time.
unquote_argv_arr() {
  local s="$1" cur="" q="" c i=0 n=${#1} started=0
  local -a out=()
  # Fast path: nothing to unquote, so plain IFS word splitting is exact and
  # skips the character loop. That loop is O(length) in bash and runs over
  # every .desktop Exec during indexing, which was most of a save.
  if [[ "$s" != *[\\\'\"]* ]]; then
    _UARGV=()
    read -r -a _UARGV <<<"$s"
    return 0
  fi
  while ((i < n)); do
    c="${s:i:1}"
    if [[ -n "$q" ]]; then
      if [[ "$c" == "$q" ]]; then
        q=""
      elif [[ "$q" == '"' && "$c" == '\' && $((i + 1)) -lt n ]]; then
        ((i++)) || true
        cur+="${s:i:1}"
      else
        cur+="$c"
      fi
      started=1
    else
      case "$c" in
        '\')
          if ((i + 1 < n)); then
            ((i++)) || true
            cur+="${s:i:1}"
          fi
          started=1
          ;;
        "'" | '"') q="$c"; started=1 ;;
        ' ' | $'\t')
          if ((started)); then
            out+=("$cur")
            cur=""
            started=0
          fi
          ;;
        *) cur+="$c"; started=1 ;;
      esac
    fi
    ((i++)) || true
  done
  ((started)) && out+=("$cur")
  _UARGV=(${out[@]+"${out[@]}"})
  return 0
}

# NUL-separated form, for callers that still read it through mapfile.
unquote_argv() {
  unquote_argv_arr "$1"
  ((${#_UARGV[@]})) && printf '%s\0' "${_UARGV[@]}"
  return 0
}

# The command a launch line actually runs, with wrappers, terminals and a
# `bash -c` shim walked off. Display only: the label is never a lookup key.
leaf_command_from_argv() {
  leaf_from_argv_into "$@" || return 1
  printf '%s\n' "$_LEAF"
}

leaf_from_argv_into() {
  local -a argv=("$@")
  local i=0 n=${#argv[@]} a
  local -a inner=()

  while ((i < n)) && { is_wrapper_cmd "${argv[i]}" || [[ "${argv[i]}" == -- ]] \
    || [[ "${argv[i]}" == [A-Za-z_]*[=]* && "${argv[i]}" != --* ]]; }; do
    ((i++)) || true
  done

  if ((i < n)) && is_terminal_cmd "${argv[i]}"; then
    ((i++)) || true
    while ((i < n)); do
      a="${argv[i]}"
      if [[ "$a" == --app-id || "$a" == --working-directory || "$a" == --dir \
        || "$a" == -D || "$a" == --title ]]; then
        i=$((i + 2))
      elif [[ "$a" == -e || "$a" == --command || "$a" == -- ]]; then
        inner=("${argv[@]:i+1}")
        break
      elif [[ "$a" == -* ]]; then
        ((i++)) || true
      else
        inner=("${argv[@]:i}")
        break
      fi
    done
  else
    inner=("${argv[@]:i}")
  fi

  ((${#inner[@]})) || { _LEAF=""; return 1; }

  # `bash -c "dua i /"` names dua, not bash.
  case "${inner[0]##*/}" in
    bash | sh | zsh | dash)
      if [[ "${inner[1]:-}" == -c && -n "${inner[2]:-}" ]]; then
        local script="${inner[2]}"
        script="${script%% *}"
        [[ -n "$script" ]] && { _LEAF="${script##*/}"; return 0; }
      fi
      ;;
  esac
  _LEAF="${inner[0]##*/}"
}

leaf_for_exec_into() {
  unquote_argv_arr "$1"
  ((${#_UARGV[@]})) || { _LEAF=""; return 1; }
  leaf_from_argv_into "${_UARGV[@]}"
}

leaf_command_for_exec() {
  leaf_for_exec_into "$1" || return 1
  printf '%s\n' "$_LEAF"
}

# Print JSON {wrapped, class, exec} from argv. A terminal hosting another
# command (foot -e herdr, omarchy-launch-terminal nvim) becomes class=that
# command and exec=xdg-terminal-exec --app-id=<class> -e <command...>, so the
# next launch has a distinct Hyprland class. No per-app special cases.
identity_into_globals() {
  local -a argv=("$@")
  local i=0 n=${#argv[@]}
  local app_id="" terminal=""
  local -a inner=()

  while ((i < n)) && { is_wrapper_cmd "${argv[i]}" || [[ "${argv[i]}" == -- ]] || [[ "${argv[i]}" == [A-Za-z_]*[=]* && "${argv[i]}" != --* ]]; }; do
    ((i++)) || true
  done

  if ((i < n)) && is_terminal_cmd "${argv[i]}"; then
    terminal="${argv[i]##*/}"
    ((i++)) || true
    while ((i < n)); do
      local a="${argv[i]}"
      if [[ "$a" == --app-id=* ]]; then
        app_id="${a#--app-id=}"
        ((i++)) || true
      elif [[ "$a" == --app-id && $((i + 1)) -lt $n ]]; then
        app_id="${argv[i + 1]}"
        i=$((i + 2))
      elif [[ "$a" == -e || "$a" == --command || "$a" == -- ]]; then
        inner=("${argv[@]:i+1}")
        break
      elif [[ "$a" == --working-directory || "$a" == --dir || "$a" == -D || "$a" == --title ]]; then
        i=$((i + 2))
      elif [[ "$a" == --working-directory=* || "$a" == --dir=* || "$a" == --title=* ]]; then
        ((i++)) || true
      elif [[ "$a" == -* ]]; then
        ((i++)) || true
      else
        inner=("${argv[@]:i}")
        break
      fi
    done
  fi

  # The app id goes through quote_argv too, not just the inner argv: boot runs
# the whole string through bash -c, so an app id containing a space would
# split into two words and one containing a metacharacter would be executed.
# -e is kept, not dropped. xdg-terminal-exec accepts it as the explicit end of
  # options, so an inner command that begins with a dash cannot be reparsed as
  # one. The rebuilt line then matches what a packaged TUI .desktop already
  # ships, e.g. Omarchy's Disk Usage.desktop.
  local class="" exec=""
  if [[ -n "$app_id" ]] && ! is_generic_terminal_class "$app_id"; then
    class="$app_id"
    if ((${#inner[@]} > 0)); then
      exec="xdg-terminal-exec $(quote_argv "--app-id=${class}") -e $(quote_argv "${inner[@]}")"
    else
      exec="xdg-terminal-exec $(quote_argv "--app-id=${class}")"
    fi
  elif ((${#inner[@]} > 0)); then
    class="${inner[0]##*/}"
    exec="xdg-terminal-exec $(quote_argv "--app-id=${class}") -e $(quote_argv "${inner[@]}")"
  fi

  _ID_WRAPPED=false
  _ID_CLASS=""
  _ID_EXEC=""
  if [[ -n "$class" ]]; then
    _ID_WRAPPED=true
    _ID_CLASS="$class"
    _ID_EXEC="$exec"
  fi
}

# JSON form, for callers and docs that still want it. The hot paths use the
# globals directly: jq costs ~10ms per spawn and this used to run several
# times per window.
identity_from_argv() {
  identity_into_globals "$@"
  if [[ "$_ID_WRAPPED" == true ]]; then
    jq -n --arg class "$_ID_CLASS" --arg exec "$_ID_EXEC" '{wrapped: true, class: $class, exec: $exec}'
  else
    jq -n '{wrapped: false}'
  fi
}

read_pid_argv() {
  local pid="$1" file arg
  local -n _argv="$2"
  _argv=()
  if [[ -n "${RELAUNCH_CMDLINE_DIR:-}" ]]; then
    file="${RELAUNCH_CMDLINE_DIR}/${pid}"
  else
    file="/proc/${pid}/cmdline"
  fi
  [[ -r "$file" ]] || return 1
  while IFS= read -r -d '' arg; do
    _argv+=("$arg")
  done <"$file"
  ((${#_argv[@]} > 0))
}

ppid_of() {
  local pid="$1" file
  if [[ -n "${RELAUNCH_CMDLINE_DIR:-}" ]]; then
    file="${RELAUNCH_CMDLINE_DIR}/${pid}.ppid"
    if [[ -r "$file" ]]; then
      tr -d '[:space:]' <"$file"
      return
    fi
    printf '0\n'
    return
  fi
  awk '/^PPid:/{print $2; exit}' "/proc/${pid}/status" 2>/dev/null || printf '0\n'
}

identity_pid_into_globals() {
  local pid="$1" hops=0 next
  local -a argv=()
  _ID_WRAPPED=false
  _ID_CLASS=""
  _ID_EXEC=""
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 0
  while [[ "$pid" =~ ^[1-9][0-9]*$ ]] && ((hops < 8)); do
    if read_pid_argv "$pid" argv; then
      identity_into_globals "${argv[@]}"
      [[ "$_ID_WRAPPED" == true ]] && return 0
    fi
    next="$(ppid_of "$pid")"
    [[ "$next" == "$pid" || "$next" == 0 ]] && break
    pid="$next"
    hops=$((hops + 1))
  done
  _ID_WRAPPED=false
  _ID_CLASS=""
  _ID_EXEC=""
  return 0
}

identity_from_pid() {
  identity_pid_into_globals "$1"
  if [[ "$_ID_WRAPPED" == true ]]; then
    jq -n --arg class "$_ID_CLASS" --arg exec "$_ID_EXEC" '{wrapped: true, class: $class, exec: $exec}'
  else
    jq -n '{wrapped: false}'
  fi
}

# Pure builtins on purpose. This is called once per key per .desktop file --
# 93 files on a normal machine -- and the previous
# `printf | tr | tr` forked a subshell and two processes every time, which
# put `save` at 10-18 seconds with jq accounting for 2% of it. Byte-identical
# output to the old pipeline; the suite pins the edge cases.
# Sets _NKEY instead of printing. A $(...) substitution forks a subshell even
# when the callee is pure builtins, and the index calls this six times per
# .desktop file, so the fork is the cost, not the work.
nkey() {
  # LC_ALL=C is load-bearing, not tidiness. ${v,,} is locale-aware Unicode
  # case folding, while the tr '[:upper:]' '[:lower:]' this replaced folded
  # ASCII only: under en_US.UTF-8, "Apps" stayed "Apps" before and would
  # become "apps" now. Key derivation decides which .desktop a class resolves
  # to, so a changed key can collapse formerly distinct entries in
  # DESKTOP_EXEC_BY_* and let the first-indexed launcher win. Byte semantics
  # keep this a pure performance change. `local` restores the previous value
  # on return, so nothing else in the script sees C.
  local LC_ALL=C
  local v="${1,,}"
  v="${v//[ _.]/-}"
  # tr -s squeezed runs of the replaced characters into one dash.
  while [[ "$v" == *--* ]]; do
    v="${v//--/-}"
  done
  _NKEY="$v"
}

normalize_desktop_key() {
  nkey "$1"
  printf '%s' "$_NKEY"
}

dlaunch_into() {
  local file="$1" id
  if command -v gio >/dev/null 2>&1; then
    printf -v _DLAUNCH 'gio launch %q' "$file"
    return 0
  fi
  if command -v gtk-launch >/dev/null 2>&1; then
    id="${file##*/}"
    id="${id%.desktop}"
    printf -v _DLAUNCH 'gtk-launch %q' "$id"
    return 0
  fi
  _DLAUNCH=""
  return 1
}

desktop_launch_cmd() {
  dlaunch_into "$1" || return 1
  printf '%s\n' "$_DLAUNCH"
}

index_set_if_empty() {
  local -n _map="$1"
  local key="$2" val="$3"
  [[ -n "$key" && -n "$val" ]] || return 0
  [[ -n "${_map[$key]:-}" ]] && return 0
  _map["$key"]="$val"
}

xdg_application_dirs() {
  local d xdg
  local -a dirs=()
  if [[ -n "${RELAUNCH_DATA_DIRS:-}" ]]; then
    IFS=: read -r -a dirs <<<"$RELAUNCH_DATA_DIRS"
    for d in "${dirs[@]}"; do
      [[ -d "$d/applications" ]] && printf '%s\n' "$d/applications"
      [[ -d "$d" && "${d##*/}" == applications ]] && printf '%s\n' "$d"
    done
    return
  fi
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  xdg="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  IFS=: read -r -a dirs <<<"$xdg"
  for d in "${dirs[@]}"; do
    [[ -d "$d/applications" ]] && printf '%s\n' "$d/applications"
  done
}

declare -A DESKTOP_EXEC_BY_CLASS=()
declare -A DESKTOP_EXEC_BY_ID=()
declare -A DESKTOP_EXEC_BY_NAME=()
declare -A DESKTOP_CLASS_BY_EXEC=()
# Reverse map for display labels only: the leaf command of a terminal-wrapping
# Exec -> that entry's Name. Omarchy ships Disk Usage.desktop with
# Exec=xdg-terminal-exec --app-id=TUI.float -e bash -c "dua i /", so `dua`
# resolves to "Disk Usage". This lookup is acceptable here precisely because a
# wrong answer is cosmetic; it was rejected for resolving launch commands.
declare -A DESKTOP_NAME_BY_LEAF=()
# Omarchy web-app index (github issue #11). Chromium encodes an --app=URL
# window class as brave-<host>_<path with / as _>-Default, which no
# StartupWMClass, desktop-file id or Name can match. Identities are compared
# forward-encoded and never decoded, because / -> _ is lossy.
declare -A WEBAPP_LAUNCH_BY_IDENTITY=()
declare -A WEBAPP_ID_BY_IDENTITY=()
declare -A WEBAPP_AMBIGUOUS=()
# XDG desktop-ID masking, for this index only. The highest-priority file
# bearing an id claims it -- even when that file is Hidden=true or is not a
# web app -- so a user override genuinely replaces the system entry instead
# of colliding with it. The class/id/Name maps keep their existing
# first-wins-per-key behaviour; general masking is a separate issue.
declare -A WEBAPP_ID_CLAIMED=()
_desktop_indexed=0
# Scratch globals for the fork-free helpers used by the indexing hot path.
_NKEY=""
_DLAUNCH=""
_DFID=""
_LEAF=""
_ID_WRAPPED=false
_ID_CLASS=""
_ID_EXEC=""
declare -a _UARGV=()

# Chromium identity for a URL: lowercase host, then the path with each / as
# an underscore. Query and fragment are excluded because Chromium discards
# them -- verified, https://example.com/?q=1 yields the same class as
# https://example.com. An empty path and / are identical at the source.
# RFC 3986 5.2.4 remove_dot_segments, transcribed literally. A segment-stack
# approximation is not equivalent: it drops empty segments and the trailing
# slash a final "." or ".." produces, so /a/b/.. would give /a instead of /a/
# and /a//b would give /a/b. Those are different Chromium identities.
remove_dot_segments() {
  local input="$1" output="" seg rest
  while [[ -n "$input" ]]; do
    if [[ "$input" == ../* ]]; then
      input="${input#../}"
    elif [[ "$input" == ./* ]]; then
      input="${input#./}"
    elif [[ "$input" == /./* ]]; then
      input="/${input#/./}"
    elif [[ "$input" == "/." ]]; then
      input="/"
    elif [[ "$input" == /../* ]]; then
      input="/${input#/../}"
      output="${output%/*}"
    elif [[ "$input" == "/.." ]]; then
      input="/"
      output="${output%/*}"
    elif [[ "$input" == "." || "$input" == ".." ]]; then
      input=""
    else
      if [[ "$input" == /* ]]; then
        rest="${input:1}"
        if [[ "$rest" == */* ]]; then
          seg="/${rest%%/*}"
        else
          seg="/$rest"
        fi
      else
        if [[ "$input" == */* ]]; then
          seg="${input%%/*}"
        else
          seg="$input"
        fi
      fi
      output+="$seg"
      input="${input#"$seg"}"
    fi
  done
  printf '%s' "$output"
}

# Chromium builds the app identity from GURL::host() and GURL::path()
# (GenerateApplicationNameFromURL). host() excludes userinfo and the port, so
# https://user@example.com:8443/app and https://example.com/app share one
# identity -- and therefore one window class. Splitting the raw URL instead
# would miss that, resolving to the wrong launcher or missing the ambiguity.
chromium_identity_from_url() {
  local url="$1" rest host path
  [[ -n "$url" ]] || return 1
  # A GURL needs a scheme. The previous guard could never fire: rest == url
  # only when there is no "://", which the second half then required.
  [[ "$url" == *"://"* ]] || return 1
  rest="${url#*://}"
  rest="${rest%%#*}"
  rest="${rest%%\?*}"
  host="${rest%%/*}"
  if [[ "$rest" == */* ]]; then
    path="/${rest#*/}"
  else
    path="/"
  fi
  # userinfo: everything up to the last @ is credentials, not host.
  host="${host##*@}"
  # port: not part of GURL::host(). Keep a bracketed IPv6 literal intact.
  if [[ "$host" == \[*\]* ]]; then
    host="${host%%\]*}]"
  else
    host="${host%%:*}"
  fi
  [[ -n "$host" ]] || return 1
  path="$(remove_dot_segments "$path")"
  printf '%s_%s\n' "${host,,}" "${path//\//_}"
}

# URL argument of an Exec=omarchy-launch-webapp line, or nothing.
webapp_url_from_exec() {
  local raw="$1" i n a
  local -a argv=()
  # Cheap reject before tokenizing: only an omarchy-launch-webapp line can
  # produce a web-app identity, and that is one file out of ninety-odd.
  [[ "$raw" == *omarchy-launch-webapp* ]] || return 1
  unquote_argv_arr "$raw"
  argv=(${_UARGV[@]+"${_UARGV[@]}"})
  n=${#argv[@]}
  ((n)) || return 1
  i=0
  while ((i < n)) && { is_wrapper_cmd "${argv[i]}" || [[ "${argv[i]}" == -- ]] \
    || [[ "${argv[i]}" == [A-Za-z_]*[=]* && "${argv[i]}" != --* ]]; }; do
    ((i++)) || true
  done
  ((i < n)) || return 1
  [[ "${argv[i]##*/}" == omarchy-launch-webapp ]] || return 1
  ((i++)) || true
  while ((i < n)); do
    a="${argv[i]}"
    # Skip flags and .desktop field codes (%u, %U, %f...).
    if [[ "$a" != -* && "$a" != %? ]]; then
      printf '%s\n' "$a"
      return 0
    fi
    ((i++)) || true
  done
  return 1
}

# XDG desktop-file ID: the path relative to the applications/ root with each
# / replaced by -, case preserved. foo/bar.desktop is the id foo-bar, and
# Foo.desktop and foo.desktop are distinct ids that must not mask each other.
dfid_into() {
  local file="$1" root="$2" rel
  rel="${file#"$root"/}"
  rel="${rel%.desktop}"
  _DFID="${rel//\//-}"
}

desktop_file_id() {
  dfid_into "$1" "$2"
  printf '%s\n' "$_DFID"
}

index_desktop_file() {
  local file="$1" root="${2:-}"
  local section="" raw_exec="" wmclass="" name="" hidden=false
  local line key val id launch
  # Cheap filter first. A .desktop file is mostly translated keys
  # (Name[de]=, Comment[fr]=, ...) -- ~600 lines each across 93 files -- and
  # only four keys matter. Matching the literal prefixes up front skips the
  # \r trim, the two parameter expansions and the section compare for every
  # line we do not want. Also stops at the first section after
  # [Desktop Entry], since nothing after it is read.
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip CR before anything else. The old parser did, and matching the
    # section header first meant "[Desktop Entry]\r" matched nothing, so a
    # CRLF file contributed no Exec, Name or StartupWMClass -- and a web app
    # could still claim its desktop id while registering no launcher, masking
    # a valid lower-priority file.
    line="${line%$'\r'}"
    case "$line" in
      \[*])
        if [[ "$section" == "[Desktop Entry]" ]]; then
          break
        fi
        section="$line"
        continue
        ;;
      Exec=* | Name=* | StartupWMClass=* | Hidden=* | hidden=*) ;;
      *) continue ;;
    esac
    [[ "$section" == "[Desktop Entry]" ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      Hidden|hidden) [[ "${val,,}" == true ]] && hidden=true ;;
      Exec) [[ -z "$raw_exec" ]] && raw_exec="$val" ;;
      StartupWMClass) wmclass="$val" ;;
      Name) [[ -z "$name" ]] && name="$val" ;;
    esac
  done <"$file"
  # Web-app index: XDG desktop-ID masking, this map only. The claim happens
  # before the Hidden early-return on purpose -- a Hidden=true user override
  # must mask the system entry rather than let it register.
  local _wid _widkey _wurl _wident
  # Case-sensitive XDG id, not the lowercased basename: normalize_desktop_key
  # collapses case, spaces, underscores and dots, which would let distinct
  # launchers mask one another or hide a real ambiguity.
  dfid_into "$file" "${root:-${file%/*}}"
  _widkey="$_DFID"
  if [[ -z "${WEBAPP_ID_CLAIMED[$_widkey]:-}" ]]; then
    WEBAPP_ID_CLAIMED[$_widkey]=1
    if ! $hidden && [[ -n "$raw_exec" ]]; then
      _wurl="$(webapp_url_from_exec "$raw_exec" 2>/dev/null || true)"
      # (one fork, only for entries that actually name a web app)
      if [[ -n "$_wurl" ]]; then
        _wident="$(chromium_identity_from_url "$_wurl" 2>/dev/null || true)"
        if [[ -n "$_wident" ]]; then
          if [[ -n "${WEBAPP_ID_BY_IDENTITY[$_wident]:-}" \
            && "${WEBAPP_ID_BY_IDENTITY[$_wident]}" != "$_widkey" ]]; then
            # Two surviving distinct ids, one identity: refuse to guess.
            WEBAPP_AMBIGUOUS[$_wident]=1
          else
            WEBAPP_ID_BY_IDENTITY[$_wident]="$_widkey"
            dlaunch_into "$file" && WEBAPP_LAUNCH_BY_IDENTITY[$_wident]="$_DLAUNCH"
          fi
        fi
      fi
    fi
  fi

  $hidden && return 0
  [[ -n "$raw_exec" ]] || return 0
  dlaunch_into "$file" || return 0
  launch="$_DLAUNCH"
  id="${file##*/}"
  id="${id%.desktop}"
  nkey "$wmclass"; local wmkey="$_NKEY"
  nkey "$id"; local idkey="$_NKEY"
  nkey "$name"; local namekey="$_NKEY"
  index_set_if_empty DESKTOP_EXEC_BY_CLASS "$wmkey" "$launch"
  index_set_if_empty DESKTOP_EXEC_BY_ID "$idkey" "$launch"
  # Name is a last-resort fallback. A Brave PWA named "Proton Mail" has
  # StartupWMClass=crx_… — do not let that Name steal the official app class.
  if [[ -z "$wmclass" || "$wmkey" == "$namekey" ]]; then
    index_set_if_empty DESKTOP_EXEC_BY_NAME "$namekey" "$launch"
  fi
  # Reverse map uses the raw Exec token so startup-line matching still works.
  nkey "$raw_exec"
  index_set_if_empty DESKTOP_CLASS_BY_EXEC "$_NKEY" "${wmclass:-$id}"
  nkey "${raw_exec%% *}"
  index_set_if_empty DESKTOP_CLASS_BY_EXEC "$_NKEY" "${wmclass:-$id}"
  if [[ -n "$name" ]]; then
    local leaf
    leaf=""
    # Only a wrapping Exec can yield a leaf that differs from its first word,
    # which is the condition below. Checking first avoids tokenizing the
    # other ninety files.
    local _first="${raw_exec%% *}"
    if is_terminal_cmd "$_first" || is_wrapper_cmd "$_first" \
      || [[ "${_first##*/}" == bash || "${_first##*/}" == sh \
         || "${_first##*/}" == zsh || "${_first##*/}" == dash ]]; then
      leaf_for_exec_into "$raw_exec" 2>/dev/null && leaf="$_LEAF"
    fi
    # Only a terminal wrap: a plain Exec=brave would map `brave` -> "Brave",
    # which tier 1 already covers from the exact file, and which would let any
    # app claim a bare command name.
    if [[ -n "$leaf" && "$leaf" != "${raw_exec%% *}" ]]; then
      nkey "$leaf"
      index_set_if_empty DESKTOP_NAME_BY_LEAF "$_NKEY" "$name"
    fi
  fi
}

# Name= straight out of one known file. Tier 1: the exec already names it.
desktop_name_from_file() {
  local file="$1" section="" line key val name=""
  [[ -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ "$line" == \[*] ]]; then
      section="$line"
      continue
    fi
    [[ "$section" == "[Desktop Entry]" ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    if [[ "$key" == Name && -z "$name" ]]; then
      name="$val"
      break
    fi
  done <"$file"
  [[ -n "$name" ]] || return 1
  printf '%s\n' "$name"
}

desktop_exec_line_from_file() {
  local file="$1" section="" line key val
  [[ -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ "$line" == \[*] ]]; then
      section="$line"
      continue
    fi
    [[ "$section" == "[Desktop Entry]" ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    if [[ "$key" == Exec ]]; then
      printf '%s\n' "$val"
      return 0
    fi
  done <"$file"
  return 1
}

# Tokens by which an autostart line can be recognised as this entry, so
# `o.launch_on_start("brave")` correlates with a saved brave-browser entry
# and the row keeps kind: both. Resolved at save/import time and stored;
# `list` must never index applications dirs to work this out.
startup_keys_for() {
  local class="$1" exec="$2" source="$3"
  local -a keys=() argv=()
  local leaf file id dexec
  [[ -n "$class" ]] && keys+=("${class,,}")
  if [[ "$source" == desktop-file ]]; then
    mapfile -t -d '' argv < <(unquote_argv "$exec")
    if ((${#argv[@]} >= 3)) && [[ "${argv[0]##*/}" == gio && "${argv[1]}" == launch ]]; then
      file="${argv[2]}"
      id="${file##*/}"
      id="${id%.desktop}"
      [[ -n "$id" ]] && keys+=("${id,,}")
      dexec="$(desktop_exec_line_from_file "$file" 2>/dev/null || true)"
      if [[ -n "$dexec" ]]; then
        leaf="$(leaf_command_for_exec "$dexec" 2>/dev/null || true)"
        [[ -n "$leaf" ]] && keys+=("${leaf,,}")
      fi
    fi
  else
    leaf="$(leaf_command_for_exec "$exec" 2>/dev/null || true)"
    [[ -n "$leaf" ]] && keys+=("${leaf,,}")
  fi
  ((${#keys[@]})) || return 0
  printf '%s\n' "${keys[@]}" | awk 'NF && !seen[$0]++'
}

startup_keys_json() {
  startup_keys_for "$1" "$2" "$3" \
    | jq -R -s 'split("\n") | map(select(length > 0))'
}

desktop_name_for_leaf() {
  local k
  ensure_desktop_index
  k="$(normalize_desktop_key "$1")"
  printf '%s\n' "${DESKTOP_NAME_BY_LEAF[$k]:-}"
}

# Human-readable name for an entry. Display only -- `class` stays the identity
# and the only lookup key, so a wrong label is cosmetic and never mis-pins a
# window. Tiers, in order:
#   1. desktop-file  -> Name= from the exact file the exec already names
#   2. terminal      -> leaf command, then a .desktop whose terminal-wrap Exec
#                       runs that leaf, else the leaf itself
#   3. anything else -> leaf of the exec
#   4. fallback      -> class
display_label_for() {
  local class="$1" exec="$2" source="$3"
  local -a argv=()
  local leaf name file

  if [[ -n "$exec" ]]; then
    case "$source" in
      desktop-file)
        mapfile -t -d '' argv < <(unquote_argv "$exec")
        # gio launch <file>
        if ((${#argv[@]} >= 3)) && [[ "${argv[0]##*/}" == gio && "${argv[1]}" == launch ]]; then
          file="${argv[2]}"
        else
          file=""
        fi
        if [[ -n "$file" ]]; then
          name="$(desktop_name_from_file "$file" 2>/dev/null || true)"
          [[ -n "$name" ]] && { printf '%s\n' "$name"; return 0; }
        fi
        ;;
      terminal)
        leaf="$(leaf_command_for_exec "$exec" 2>/dev/null || true)"
        if [[ -n "$leaf" ]]; then
          name="$(desktop_name_for_leaf "$leaf")"
          [[ -n "$name" ]] && { printf '%s\n' "$name"; return 0; }
          printf '%s\n' "$leaf"
          return 0
        fi
        ;;
    esac
    leaf="$(leaf_command_for_exec "$exec" 2>/dev/null || true)"
    [[ -n "$leaf" ]] && { printf '%s\n' "$leaf"; return 0; }
  fi
  printf '%s\n' "$class"
}

ensure_desktop_index() {
  local dir f
  ((_desktop_indexed)) && return 0
  _desktop_indexed=1
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    while IFS= read -r -d '' f; do
      index_desktop_file "$f" "$dir"
    # -L: distro .desktop files are often symlinks (LibreOffice ships
    # /usr/share/applications/libreoffice-calc.desktop -> .../xdg/calc.desktop).
    # find -type f without -L skips those and Calc falls through to cmdline.
    done < <(find -L "$dir" -maxdepth 2 -type f -name '*.desktop' -print0 2>/dev/null)
  done < <(xdg_application_dirs)
}

# Launch command for a Chromium app-mode window class, or nothing. Only
# brave-<identity>-Default is supported: that is the one form verified on
# hardware. A custom profile or another browser stays unresolved and keeps
# the existing cmdline fallback rather than being guessed at.
webapp_launch_for_class() {
  local class="$1" ident
  [[ "$class" == brave-*-Default ]] || return 1
  ident="${class#brave-}"
  ident="${ident%-Default}"
  [[ -n "$ident" ]] || return 1
  [[ -n "${WEBAPP_AMBIGUOUS[$ident]:-}" ]] && return 1
  [[ -n "${WEBAPP_LAUNCH_BY_IDENTITY[$ident]:-}" ]] || return 1
  printf '%s\n' "${WEBAPP_LAUNCH_BY_IDENTITY[$ident]}"
}

desktop_exec_for_class() {
  local k hit
  ensure_desktop_index
  k="$(normalize_desktop_key "$1")"
  # Window match: StartupWMClass, then desktop-file id, then the Omarchy
  # web-app identity, then Name. The web-app tier is exact, so it outranks
  # the last-resort Name key, but it must not pre-empt a real
  # StartupWMClass. Name stays last so a PWA that reuses a friendly Name
  # cannot steal the pin class.
  hit="${DESKTOP_EXEC_BY_CLASS[$k]:-${DESKTOP_EXEC_BY_ID[$k]:-}}"
  if [[ -z "$hit" ]]; then
    hit="$(webapp_launch_for_class "$1" 2>/dev/null || true)"
  fi
  if [[ -z "$hit" ]]; then
    hit="${DESKTOP_EXEC_BY_NAME[$k]:-}"
  fi
  printf '%s\n' "$hit"
}

desktop_class_for_exec() {
  local k
  ensure_desktop_index
  k="$(normalize_desktop_key "$1")"
  printf '%s\n' "${DESKTOP_CLASS_BY_EXEC[$k]:-${DESKTOP_CLASS_BY_EXEC[$(normalize_desktop_key "${1%% *}")]:-}}"
}

is_helper_argv() {
  local a
  [[ "${1##*/}" == *crashpad* || "${1##*/}" == oosplash ]] && return 0
  for a in "$@"; do
    case "$a" in
      --type=renderer|--type=zygote|--type=gpu-process|--type=utility|--type=plugin)
        return 0
        ;;
    esac
  done
  return 1
}

cmdline_exec_for_pid() {
  local pid="$1" hops=0 next
  local -a argv=()
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  while [[ "$pid" =~ ^[1-9][0-9]*$ ]] && ((hops < 8)); do
    if read_pid_argv "$pid" argv && ((${#argv[@]} > 0)); then
      if ! is_helper_argv "${argv[@]}"; then
        # Not "${argv[*]}": boot runs this through bash -c, so a joined
        # string re-splits and any space, quote, semicolon, ampersand, glob
        # or $(...) in an argument changes meaning at launch. Same bug the
        # hosted-terminal path already fixes with quote_argv.
        printf '%s\n' "$(quote_argv "${argv[@]}")"
        return 0
      fi
    fi
    next="$(ppid_of "$pid")"
    [[ "$next" == "$pid" || "$next" == 0 ]] && break
    pid="$next"
    hops=$((hops + 1))
  done
  return 1
}

class_for_startup_exec() {
  # --cheap skips the .desktop index. Display/list must use that so opening
  # the panel does not walk every application dir.
  local cheap=0
  if [[ "${1:-}" == --cheap ]]; then
    cheap=1
    shift
  fi
  local exec="$1" ident class mapped first="" token base
  local -a argv=()
  split_exec_words "$exec" argv
  ident="$(identity_from_argv "${argv[@]}")"
  class="$(jq -r 'if .wrapped then .class else empty end' <<<"$ident")"
  if [[ -n "$class" ]]; then
    printf '%s\n' "$class"
    return
  fi
  if ! ((cheap)); then
    mapped="$(desktop_class_for_exec "$exec")"
    if [[ -n "$mapped" ]]; then
      printf '%s\n' "$mapped"
      return
    fi
  fi
  for token in "${argv[@]}"; do
    [[ "$token" == -* || "$token" == -- ]] && continue
    [[ "$token" == *=* ]] && continue
    base="${token##*/}"
    is_wrapper_cmd "$base" && continue
    [[ -z "$first" ]] && first="$base"
    if ! ((cheap)); then
      mapped="$(desktop_class_for_exec "$base")"
      if [[ -n "$mapped" && "$mapped" != "$base" ]]; then
        printf '%s\n' "$mapped"
        return
      fi
    fi
  done
  printf '%s\n' "${first:-${argv[0]:-}}"
}

ensure_overrides_file() {
  local p
  p="$(overrides_path)"
  mkdir -p "$(config_dir)"
  if [[ ! -f "$p" ]]; then
    printf '{}\n' >"$p"
  fi
}

load_overrides_json() {
  local p
  ensure_overrides_file
  p="$(overrides_path)"
  jq -e 'if type == "object" then . else {} end' "$p" 2>/dev/null || printf '{}\n'
}

override_exec_for_class() {
  local class="$1"
  load_overrides_json | jq -r --arg c "$class" '
    to_entries
    | map(select((.key | ascii_downcase) == ($c | ascii_downcase)))
    | .[0].value // empty
  '
}

set_override_exec() {
  local class="$1" exec="$2" json
  ensure_overrides_file
  json="$(load_overrides_json | jq --arg c "$class" --arg e "$exec" '
    with_entries(select((.key | ascii_downcase) != ($c | ascii_downcase)))
    + {($c): $e}
  ')"
  printf '%s\n' "$json" | atomic_write "$(overrides_path)"
}

unset_override_exec() {
  local class="$1" json
  ensure_overrides_file
  json="$(load_overrides_json | jq --arg c "$class" '
    with_entries(select((.key | ascii_downcase) != ($c | ascii_downcase)))
  ')"
  printf '%s\n' "$json" | atomic_write "$(overrides_path)"
}

exec_is_ok() {
  local exec="$1" token
  token="${exec%% *}"
  [[ -n "$token" ]] || return 1
  command -v "$token" >/dev/null 2>&1 && return 0
  [[ -x "$token" ]]
}

resolve_launch() {
  # Prints: exec<TAB>source
  local class="$1" pid="$2"
  local exec
  identity_pid_into_globals "$pid"
  if [[ "$_ID_WRAPPED" == true ]]; then
    # Not @tsv: it escapes backslashes, and a shell-quoted hosted command
    # legitimately contains them (bash -c dua\ i\ /).
    printf '%s\t%s\n' "$_ID_EXEC" "terminal"
    return
  fi
  exec="$(override_exec_for_class "$class")"
  if [[ -n "$exec" ]]; then
    printf '%s\t%s\n' "$exec" "overrides-table"
    return
  fi
  exec="$(desktop_exec_for_class "$class")"
  if [[ -n "$exec" ]]; then
    printf '%s\t%s\n' "$exec" "desktop-file"
    return
  fi
  exec="$(cmdline_exec_for_pid "$pid" || true)"
  if [[ -n "$exec" ]]; then
    printf '%s\t%s\n' "$exec" "cmdline"
    return
  fi
  printf '%s\t%s\n' "${class,,}" "guess"
}

annotate_clients() {
  # mode=display: only unwrap terminal hosts (cheap /proc walk). Do not
  # index .desktop files or read cmdline launchers — that is save/import.
  local clients="$1" mode="${2:-full}"
  local addr pid class exec source patches line label skeys
  # One JSON object per window, assembled into the array once at the end.
  # Re-running jq over the whole accumulator per window was O(n) spawns of an
  # O(n) document.
  local -a rows=()
  patches='[]'
  # Warm the index in THIS shell before the loop. resolve_launch runs inside
  # a $(...) subshell, which gets a copy of _desktop_indexed and of the index
  # arrays; with a cold parent every window rebuilt the whole index and threw
  # it away, turning a 170ms scan into 170ms x windows. Display mode must not
  # index at all, so it is excluded.
  [[ "$mode" == display ]] || ensure_desktop_index
  # Keyed by window address, not pid. Chromium serves every web app from one
  # process, so a Google Maps window and the ordinary browser window share a
  # pid; keying patches by pid collapsed them through from_entries and gave
  # both windows whichever resolution was processed last.
  while IFS=$'\t' read -r addr pid class; do
    [[ -z "$pid" || "$pid" == null ]] && continue
    [[ -z "$addr" || "$addr" == null ]] && continue
    if [[ "$mode" == display ]]; then
      identity_pid_into_globals "$pid"
      if [[ "$_ID_WRAPPED" == true ]]; then
        rows+=("$(jq -nc --arg addr "$addr" --arg class "$_ID_CLASS" --arg exec "$_ID_EXEC" \
          '{addr: $addr, wrapped: true, class: $class, exec: $exec, execSource: "terminal"}')")
      fi
      continue
    fi
    line="$(resolve_launch "$class" "$pid")"
    exec="${line%%$'\t'*}"
    source="${line#*$'\t'}"
    if [[ "$source" == terminal ]]; then
      identity_pid_into_globals "$pid"
      label="$(display_label_for "$_ID_CLASS" "$exec" "$source")"
      skeys="$(startup_keys_json "$_ID_CLASS" "$exec" "$source")"
      rows+=("$(jq -nc --arg addr "$addr" --arg class "$_ID_CLASS" --arg exec "$exec" --arg label "$label" --argjson skeys "$skeys" \
        '{addr: $addr, wrapped: true, class: $class, exec: $exec, execSource: "terminal", label: $label, startupKeys: $skeys}')")
      continue
    fi
    label="$(display_label_for "$class" "$exec" "$source")"
    skeys="$(startup_keys_json "$class" "$exec" "$source")"
    rows+=("$(jq -nc --arg addr "$addr" --arg class "$class" --arg exec "$exec" --arg src "$source" --arg label "$label" --argjson skeys "$skeys" \
      '{addr: $addr, wrapped: false, class: $class, exec: $exec, execSource: $src, label: $label, startupKeys: $skeys}')")
  done < <(jq -r '
    .[] | select(.pid != null)
    | [
        # Real hyprctl always reports an address; fall back to the pid so a
        # fixture or an odd payload without one still resolves.
        (if (.address // "") != "" then .address else "pid:" + (.pid | tostring) end),
        (.pid | tostring),
        (if (.initialClass // "") != "" then .initialClass else (.class // "") end)
      ] | @tsv
  ' <<<"$clients")
  if ((${#rows[@]} == 0)); then
    printf '%s\n' "$clients"
    return
  fi
  patches="$(printf '%s\n' "${rows[@]}" | jq -sc .)"
  jq --argjson patches "$patches" '
    ($patches | map({key: .addr, value: .}) | from_entries) as $by
    | map(
        (
          (if (.address // "") != "" then .address else "pid:" + (.pid | tostring) end)
        ) as $akey
        | (($by[$akey]) // null) as $p
        | if $p == null then .
          elif $p.wrapped == true then
            .class = $p.class
            | .initialClass = $p.class
            | .relaunchExec = $p.exec
            | .relaunchExecSource = $p.execSource
            | .relaunchLabel = ($p.label // "")
            | .relaunchStartupKeys = ($p.startupKeys // [])
          else
            .relaunchExec = $p.exec
            | .relaunchExecSource = $p.execSource
            | .relaunchLabel = ($p.label // "")
            | .relaunchStartupKeys = ($p.startupKeys // [])
          end
      )
  ' <<<"$clients"
}

scan_startup() {
  local file line kind exec id class n=0
  file="$(autostart_path)"
  if [[ ! -f "$file" ]]; then
    printf '[]\n'
    return
  fi
  local items='[]'
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    [[ "$line" =~ ^[[:space:]]*-- ]] && continue
    kind=""
    exec=""
    if [[ "$line" =~ o\.launch_on_start\([[:space:]]*\"([^\"]+)\" ]]; then
      kind="launch_on_start"
      exec="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ o\.exec_on_start\([[:space:]]*\"([^\"]+)\" ]]; then
      kind="exec_on_start"
      exec="${BASH_REMATCH[1]}"
    else
      continue
    fi
    is_relaunch_exec "$exec" && continue
    id="lua:${kind}:${exec}"
    class="$(class_for_startup_exec --cheap "$exec")"
    items="$(jq --arg id "$id" --arg source "$(basename "$file")" --arg kind "$kind" \
      --arg exec "$exec" --arg class "$class" --argjson line "$n" \
      '. + [{id: $id, source: $source, kind: $kind, exec: $exec, class: $class, line: $line}]' \
      <<<"$items")"
  done <"$file"
  printf '%s\n' "$items"
}

boot_state_json() {
  local disabled=false skip=false
  [[ -f "$(disabled_path)" ]] && disabled=true
  [[ -f "$(skip_path)" ]] && skip=true
  config_skip_once && skip=true
  jq -n --argjson disabled "$disabled" --argjson skip "$skip" \
    '{disabled: $disabled, skipOnce: $skip, active: (($disabled or $skip) | not)}'
}

build_rows() {
  local cfg startup clients
  cfg="$1"
  startup="$2"
  clients="${3:-[]}"
  jq --argjson startup "$startup" --argjson clients "$clients" "$jq_lib"'
    load_config as $cfg
    | ($cfg.ignored) as $ign
    | ([ $cfg.entries[] | {key: (.class | ascii_downcase), value: .} ] | from_entries) as $byClass
    | ([ $cfg.entries[] | {key: (.exec | ascii_downcase), value: .} ] | from_entries) as $byExec
    | [
        $cfg.entries[]
        | . as $e
        | (($e.startupKeys // [])) as $keys
        | ($startup | map(select(
              . as $sl
              | ($sl.class | ascii_downcase) == ($e.class | ascii_downcase)
                or ($sl.exec | ascii_downcase) == ($e.exec | ascii_downcase)
                or ($keys | index($sl.class | ascii_downcase)) != null
                or ($keys | index($sl.exec | ascii_downcase)) != null
                or ($keys | index($sl.exec | ascii_downcase | split(" ")[0])) != null
            )) | .[0] // null) as $s
        | {
            id: ("relaunch:" + $e.class),
            kind: (if $s != null then (if ($ign | index($s.id)) then "relaunch" else "both" end) else "relaunch" end),
            class: $e.class,
            label: (if ($e.label // "") != "" then $e.label else $e.class end),
            exec: (if $e.exec != "" then $e.exec else ($e.class | guess_exec) end),
            execSource: ($e.execSource // ""),
            workspace: $e.workspace,
            enabled: $e.enabled,
            inRelaunch: true,
            ignored: (if $s != null then (($ign | index($s.id)) != null) else false end),
            startupId: (if $s != null then $s.id else null end)
          }
      ] | sort_by(.workspace, .class) as $fromRelaunch
    | [
        $startup[]
        | . as $s
        | select(([$fromRelaunch[] | .startupId] | index($s.id)) == null)
        | (
            $byClass[($s.class | ascii_downcase)]
            // $byExec[($s.exec | ascii_downcase)]
            // $byExec[($s.exec | split(" ")[0] | ascii_downcase)]
            // null
          ) as $e
        | select($e == null)
        | {
            id: $s.id,
            kind: (if ($ign | index($s.id)) then "ignored" else "startup" end),
            class: $s.class,
            label: (if $s.class != "" then $s.class else $s.exec end),
            exec: $s.exec,
            workspace: 0,
            enabled: false,
            inRelaunch: false,
            ignored: (($ign | index($s.id)) != null),
            startupId: $s.id
          }
      ] as $fromStartup
    | (
        $clients
        | map(. + {match: (if (.initialClass // "") != "" then .initialClass else (.class // "") end)})
        | map(select(.match != "" and ((.workspace.id // 0) >= 1)))
        | sort_by(.workspace.id, .match)
        | unique_by(.match)
      ) as $running
    | [
        $running[]
        | . as $c
        | select($byClass[($c.match | ascii_downcase)] == null)
        | {
            id: ("running:" + $c.match),
            kind: "running",
            class: $c.match,
            label: $c.match,
            exec: (if ($c.relaunchExec // "") != "" then $c.relaunchExec else ($c.match | guess_exec) end),
            execSource: (if ($c.relaunchExecSource // "") != "" then $c.relaunchExecSource else "guess" end),
            workspace: $c.workspace.id,
            enabled: false,
            inRelaunch: false,
            ignored: false,
            startupId: null
          }
      ] as $fromRunning
    | ($fromRunning + $fromRelaunch + $fromStartup)
  ' <<<"$cfg"
}

decorate_items() {
  local _items="$1"
  local _meta='[]'
  local _class _exec _src _ok _unverified
  while IFS=$'\037' read -r _class _exec _src; do
    [[ -n "$_class" ]] || continue
    if [[ -z "$_src" ]]; then
      if [[ -n "$(override_exec_for_class "$_class")" ]]; then
        _src="overrides-table"
      elif [[ "$_exec" == "${_class,,}" ]]; then
        _src="guess"
      fi
    fi
    if exec_is_ok "$_exec"; then _ok=true; else _ok=false; fi
    if [[ "$_src" == guess || "$_src" == cmdline ]]; then _unverified=true; else _unverified=false; fi
    _meta="$(jq --arg class "$_class" --arg exec "$_exec" --arg src "$_src" \
      --argjson ok "$_ok" --argjson unverified "$_unverified" '
        . + [{
          class: $class,
          exec: $exec,
          execSource: $src,
          execOk: $ok,
          unverified: $unverified
        }]
      ' <<<"$_meta")"
  # Unit separator, not @tsv: @tsv escapes backslashes and a shell-quoted
  # hosted command legitimately contains them.
  done < <(jq -r '.[] | [(.class // ""), (.exec // ""), (.execSource // "")] | join("\u001f")' <<<"$_items")
  jq --argjson meta "$_meta" '
    ($meta | map({key: .class, value: .}) | from_entries) as $by
    | map(
        . as $it
        | ($by[$it.class] // {execSource: ($it.execSource // ""), execOk: true, unverified: false}) as $m
        | .execSource = $m.execSource
        | .execOk = $m.execOk
        | .unverified = $m.unverified
      )
  ' <<<"$_items"
}

emit_state() {
  local cfg startup rows extra clients entries warnings
  ensure_overrides_file
  cfg="$(load_config_json)"
  startup="$(scan_startup)"
  clients="$(clients_display)"
  rows="$(build_rows "$cfg" "$startup" "$clients")"
  local _entf _rowf
  _entf="$(mktemp)"
  _rowf="$(mktemp)"
  decorate_items "$(jq -c '.entries' <<<"$cfg")" >"$_entf"
  decorate_items "$rows" >"$_rowf"
  entries="$(cat "$_entf")"
  rows="$(cat "$_rowf")"
  rm -f "$_entf" "$_rowf"
  if ! jq -e . >/dev/null 2>&1 <<<"$entries"; then
    entries="$(jq -c '.entries' <<<"$cfg")"
  fi
  if ! jq -e . >/dev/null 2>&1 <<<"$rows"; then
    rows='[]'
  fi
  cfg="$(jq --argjson entries "$entries" '.entries = $entries' <<<"$cfg")"
  warnings="$(jq '[.[] | select(.execOk == false) | {
    class, exec, execSource, execOk,
    message: ("command not found: " + ((.exec | split(" "))[0] // .exec))
  }]' <<<"$entries")"
  extra='{}'
  if [[ -n "${1:-}" ]]; then extra="$1"; fi
  extra="$(jq --argjson warnings "$warnings" '. + {warnings: $warnings}' <<<"$extra")"
  jq -n --argjson cfg "$cfg" --argjson startup "$startup" --argjson rows "$rows" \
    --argjson boot "$(boot_state_json)" --argjson lastBoot "$(last_boot_state_json)" \
    --argjson extra "$extra" \
    --arg snippet "$(lua_path)" --arg config "$(config_path)" \
    '{
      ok: true,
      staggerSeconds: $cfg.staggerSeconds,
      entries: $cfg.entries,
      ignored: $cfg.ignored,
      startup: $startup,
      rows: $rows,
      boot: $boot,
      lastBoot: $lastBoot,
      snippetPath: $snippet,
      configPath: $config,
      warnings: $extra.warnings
    } + $extra'
}

last_boot_state_json() {
  local p text
  p="$(last_boot_json_path)"
  if [[ ! -f "$p" ]]; then
    printf 'null\n'
    return
  fi
  text=""
  [[ -f "$(last_boot_log_path)" ]] && text="$(cat "$(last_boot_log_path)")"
  jq --arg text "$text" --arg logPath "$(last_boot_log_path)" \
    '. + {text: $text, logPath: $logPath}' "$p"
}

write_last_boot() {
  local started="$1" outcome="$2" reason="$3" launches="${4:-[]}" stagger="${5:-0}"
  local json
  mkdir -p "$(config_dir)"
  json="$(jq -n \
    --arg startedAt "$started" \
    --arg outcome "$outcome" \
    --arg reason "$reason" \
    --argjson launches "$launches" \
    --argjson stagger "$stagger" \
    '{
      startedAt: $startedAt,
      outcome: $outcome,
      reason: $reason,
      staggerSeconds: $stagger,
      launches: $launches
    }')"
  printf '%s\n' "$json" | atomic_write "$(last_boot_json_path)"
  {
    printf 'relaunch boot  %s\n' "$started"
    printf 'outcome: %s\n' "$outcome"
    [[ -n "$reason" ]] && printf 'reason:  %s\n' "$reason"
    printf 'stagger: %ss\n' "$stagger"
    if [[ "$launches" != "[]" ]]; then
      printf '\nlaunches:\n'
      jq -r '
        .[] |
        "  ws \(.workspace)  \(.class)  \(.status)  pid=\(.pid // "-")"
        + (if .actualWorkspace != null then "  landed=ws \(.actualWorkspace) class=\(.actualClass // "?")" else "" end)
        + (
            if (.outcome // "") == "misplaced" then "  MISPLACED"
            elif (.outcome // "") == "pending" then "  PENDING (no window yet)"
            else "" end
          )
        + "  \(.exec)"
        + (if .error then "  (\(.error))" else "" end)
      ' <<<"$launches"
    fi
  } | atomic_write "$(last_boot_log_path)"
}

# Placement has three outcomes, not two. A single immediate sample cannot
# tell "came back on the wrong workspace" from "has not mapped a window yet":
# LibreOffice and Chromium web apps take tens of seconds, and both were
# reported MISPLACED after restoring correctly. Only `misplaced` is a
# failure.
#
#   landed    a window of this class is on the expected workspace
#   misplaced a window exists, on a different workspace
#   pending   no window of this class yet, within the deadline
#
# Bounded re-sampling, not a watcher: this runs at boot. Entries still
# pending are re-checked until the deadline, and everything that has already
# resolved is left alone.
verify_launches() {
  local launches="$1" clients
  local wait_total="${RELAUNCH_VERIFY_SLEEP:-2}"
  local deadline="${RELAUNCH_VERIFY_DEADLINE:-20}"
  local interval="${RELAUNCH_VERIFY_INTERVAL:-2}"
  local elapsed=0

  if [[ "$wait_total" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk "BEGIN{exit !($wait_total > 0)}"; then
    sleep "$wait_total"
  fi
  if ! clients="$(clients_raw)"; then
    printf '%s\n' "$launches"
    return
  fi
  launches="$(verify_sample "$launches" "$clients")"

  # Re-sample only while something is still pending and the deadline allows.
  while [[ "$deadline" =~ ^[0-9]+$ ]] && ((deadline > 0)) \
    && [[ "$interval" =~ ^[0-9]+$ ]] && ((interval > 0)) \
    && ((elapsed < deadline)); do
    jq -e 'any(.[]; .outcome == "pending")' >/dev/null <<<"$launches" || break
    sleep "$interval"
    elapsed=$((elapsed + interval))
    clients="$(clients_raw)" || break
    launches="$(verify_sample "$launches" "$clients")"
  done
  printf '%s\n' "$launches"
}

verify_sample() {
  local launches="$1" clients="$2"
  jq --argjson clients "$clients" '
    map(
      . as $l
      # Already resolved: do not re-open a decision a later sample cannot
      # improve. Only pending entries are re-examined.
      | if (.outcome // "pending") != "pending" then .
        else
          (
            $clients
            | map(select(
                (.pid == $l.pid)
                or ((.initialClass // .class // "") == $l.class)
              ))
          ) as $all
          | (
              $all
              | map(select(.workspace.id == $l.workspace))
              | .[0]
            ) as $onTarget
          | ($onTarget // ($all | .[0]) // null) as $w
          | . + {
              actualClass: (if $w == null then null else ($w.initialClass // $w.class) end),
              actualWorkspace: (if $w == null then null else $w.workspace.id end),
              outcome: (
                if $w == null then "pending"
                elif $onTarget != null then "landed"
                else "misplaced" end
              ),
              # Kept for compatibility: true only when it really landed, so
              # an unresolved entry no longer reads as a failure.
              placed: ($onTarget != null)
            }
        end
    )
  ' <<<"$launches"
}

clients_raw() {
  local out
  if ! out="$("$HYPRCTL" clients -j)"; then
    die "hyprctl clients: command failed"
  fi
  jq -e 'type == "array"' >/dev/null <<<"$out" || die "hyprctl clients: expected a JSON array"
  printf '%s\n' "$out"
}

clients_json() {
  annotate_clients "$(clients_raw)" full
}

monitors_raw() {
  # Lenient on purpose: the snapshot is a nice-to-have, so a save must not
  # fail because monitors could not be read. Missing data degrades to empty
  # name/description, not an error.
  local out
  if ! out="$("$HYPRCTL" monitors -j 2>/dev/null)"; then
    printf '%s\n' '[]'
    return
  fi
  if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$out"; then
    printf '%s\n' '[]'
    return
  fi
  printf '%s\n' "$out"
}

clients_display() {
  annotate_clients "$(clients_raw)" display
}

pid_for_running_class() {
  local class="$1" clients pid hit
  clients="$(clients_raw)" || return 1
  hit="$(jq -r --arg c "$class" '
    map(select(
      ((.initialClass // .class // "") | ascii_downcase) == ($c | ascii_downcase)
      and (.pid != null)
    ) | .pid)
    | .[0] // empty
  ' <<<"$clients")"
  if [[ -n "$hit" ]]; then
    printf '%s\n' "$hit"
    return 0
  fi
  # A hosted terminal reports the terminal class to Hyprland: `foot -e herdr`
  # is class foot, while list shows the unwrapped identity herdr. Without this
  # walk, `import --class herdr` finds no pid and stores a bare guess instead
  # of the xdg-terminal-exec wrap. Only reached when the direct match failed,
  # so the /proc walk stays off the common path.
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    identity_pid_into_globals "$pid"
    [[ "$_ID_WRAPPED" == true ]] || continue
    if [[ "${_ID_CLASS,,}" == "${class,,}" ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done < <(jq -r '.[] | select(.pid != null) | .pid' <<<"$clients")
  return 1
}

cmd_save() {
  local cfg clients merged extra
  ensure_hooks
  cfg="$(load_config_json)"
  clients="$(clients_json)"
  merged="$(jq --argjson clients "$clients" "$jq_lib"' capture($clients)' <<<"$cfg")"
  jq "$jq_lib"' del(.added, .updated) | dump_config' <<<"$merged" | atomic_write "$(config_path)"
  jq "$jq_lib"' del(.added, .updated)' <<<"$merged" | write_generated
  extra="$(jq '{added: .added, updated: .updated}' <<<"$merged")"
  if $json_out; then
    emit_state "$extra"
  else
    jq -r '"Captured: \(.added) new, \(.updated) updated."' <<<"$merged"
    printf 'Rules: %s\n' "$(lua_path)"
    printf 'Run `relaunch reload` or reboot to apply.\n'
  fi
}

cmd_generate() {
  ensure_hooks
  load_config_json | write_generated
  if $json_out; then
    emit_state
  else
    printf 'Wrote %s\n' "$(lua_path)"
  fi
}

cmd_list() {
  ensure_hooks
  if $json_out; then
    emit_state
    return
  fi
  local cfg
  cfg="$(load_config_json)"
  printf 'boot: %s\n' "$(boot_state_json | jq -r 'if .disabled then "disabled" elif .skipOnce then "skip-next" else "on" end')"
  if jq -e '.entries | length == 0' >/dev/null <<<"$cfg"; then
    printf 'No relaunch entries. Run `relaunch save`.\n'
  else
    # Label first because it is what a human recognises, but class stays on
    # the line: it is what the generated pin actually matches.
    printf '%-4s %-3s %-22s %-22s %s\n' ws on name class exec
    jq -r "$jq_lib"'
      .entries[]
      | [
          (.workspace | tostring),
          (if .enabled then "x" else " " end),
          (if (.label // "") != "" then .label else .class end),
          .class,
          (if .exec != "" then .exec else (.class | guess_exec) + " *" end)
        ]
      | join("\u001f")
    ' <<<"$cfg" | while IFS=$'\037' read -r ws on label class exec; do
      printf '%-4s [%s] %-22s %-22s %s\n' "$ws" "$on" "$label" "$class" "$exec"
    done
  fi
  local startup
  startup="$(scan_startup)"
  if jq -e 'length > 0' >/dev/null <<<"$startup"; then
    printf '\nstartup apps (autostart.lua):\n'
    jq -r '.[] | "  [\(.kind)] \(.exec)  class=\(.class)"' <<<"$startup"
  fi
}

cmd_reload() {
  "$HYPRCTL" reload || die "hyprctl reload failed"
  if $json_out; then
    emit_state
  else
    printf 'Hyprland reloaded.\n'
  fi
}

cmd_boot() {
  # Hidden autostart hook. Never listed as a startup app.
  local started cfg stagger line class ws exec token status pid err launches first_launch
  started="$(date -Iseconds)"
  mkdir -p "$(config_dir)"
  if [[ -f "$(disabled_path)" ]]; then
    write_last_boot "$started" disabled "disabled flag present" "[]" 0
    exit 0
  fi
  if [[ -f "$(skip_path)" ]] || config_skip_once; then
    set_skip_once false
    load_config_json | write_generated
    write_last_boot "$started" skipped "skip-once consumed; rules restored for the next boot" "[]" 0
    exit 0
  fi
  cfg="$(load_config_json)"
  stagger="$(jq -r '.staggerSeconds' <<<"$cfg")"
  launches='[]'
  first_launch=true
  while IFS=$'\037' read -r class ws exec; do
    [[ -z "$exec" ]] && continue
    is_relaunch_exec "$exec" && continue
    if [[ "$stagger" =~ ^[1-9][0-9]*$ ]]; then
      if $first_launch; then
        first_launch=false
      else
        if [[ -n "${RELAUNCH_SLEEP:-}" ]]; then
          "$RELAUNCH_SLEEP" "$stagger"
        else
          sleep "$stagger"
        fi
      fi
    fi
    token="${exec%% *}"
    token="${token##*/}"
    pid=""
    err=""
    if [[ "$token" != *=* ]] && ! command -v "${exec%% *}" >/dev/null 2>&1 && [[ ! -x "${exec%% *}" ]]; then
      status="not_found"
      err="command not found: ${exec%% *}"
    else
      bash -c "$exec" &
      pid=$!
      if kill -0 "$pid" 2>/dev/null; then
        status="started"
      else
        status="failed"
        err="process exited immediately"
        pid=""
      fi
    fi
    launches="$(jq --arg class "$class" --argjson ws "$ws" --arg exec "$exec" \
      --arg status "$status" --arg pid "$pid" --arg error "$err" '
        . + [{
          class: $class,
          workspace: $ws,
          exec: $exec,
          status: $status,
          pid: (if $pid == "" then null else ($pid | tonumber) end),
          error: (if $error == "" then null else $error end)
        }]
      ' <<<"$launches")"
  # Unit separator, not @tsv: @tsv escapes backslashes, and boot runs this exec
  # through bash -c, so a doubled backslash would break a shell-quoted hosted
  # command (bash -c dua\ i\ /) right at launch.
  done < <(jq -r "$jq_lib"'
    enabled_entries[]
    | [ .class, (.workspace | tostring), (if .exec != "" then .exec else (.class | guess_exec) end) ]
    | join("\u001f")
  ' <<<"$cfg")
  launches="$(verify_launches "$launches")"
  write_last_boot "$started" launched "" "$launches" "$stagger"
}

cmd_last_boot() {
  local open=false a
  for a in "$@"; do
    [[ "$a" == --open ]] && open=true
  done
  if [[ ! -f "$(last_boot_log_path)" ]]; then
    die "no last-boot log yet (reboot or run: relaunch boot)"
  fi
  if $open; then
    command -v omarchy-launch-editor >/dev/null 2>&1 || die "omarchy-launch-editor not found"
    omarchy-launch-editor "$(last_boot_log_path)" &
    if $json_out; then
      emit_state
    else
      printf 'Opened %s\n' "$(last_boot_log_path)"
    fi
    return
  fi
  if $json_out; then
    last_boot_state_json
    return
  fi
  cat "$(last_boot_log_path)"
}

# Snapshot of the real layout, for diffing against what came back. Opt-in and
# purely diagnostic: nothing in save, generate or boot reads it.
cmd_snapshot() {
  local clients monitors out
  clients="$(clients_raw)"
  monitors="$(monitors_raw)"
  out="$(jq -n --argjson clients "$clients" --argjson monitors "$monitors" \
    --arg at "$(date -Iseconds)" "$jq_lib"'
    (
      $monitors
      | map({key: ((.id // -1) | tostring), value: {name: (.name // ""), description: (.description // "")}})
      | from_entries
    ) as $mon
    | {
        capturedAt: $at,
        windows: (
          $clients
          | map(
              ((.monitor // -1) | tostring) as $mid
              | {
                  class: match_class,
                  label: "",
                  workspace: ((.workspace.id // 0) | tonumber),
                  floating: (.floating == true),
                  monitor: ((.monitor // -1) | tonumber),
                  monitorName: ($mon[$mid].name // ""),
                  monitorDescription: ($mon[$mid].description // ""),
                  pid: (.pid // 0),
                  title: (.title // "")
                }
            )
          | sort_by(.workspace, .class)
        )
      }
  ')"
  # Labels are the stored ones, never resolved here. Indexing .desktop files
  # would be slow and pointless for a diagnostic the user invoked by hand and
  # is waiting on.
  out="$(jq --argjson cfg "$(load_config_json)" '
    (
      $cfg.entries
      | map(select((.label // "") != ""))
      | map({key: .class, value: .label})
      | from_entries
    ) as $byClass
    # An empty label is not a label: jq only treats null and false as falsy,
    # so // would happily hand back "".
    | .windows |= map(.label = ($byClass[.class] // .class))
  ' <<<"$out")"
  printf '%s\n' "$out" | atomic_write "$(last_session_path)"
  if $json_out; then
    printf '%s\n' "$out" | jq '{ok: true, capturedAt: .capturedAt, windows: .windows}'
  else
    printf 'Wrote %s (%s windows)\n' "$(last_session_path)" "$(jq '.windows | length' <<<"$out")"
  fi
}

# Diff the manual snapshot against what the last boot actually produced.
cmd_last_session() {
  local diff_mode=false a
  for a in "$@"; do
    [[ "$a" == --diff ]] && diff_mode=true
  done
  [[ -f "$(last_session_path)" ]] \
    || die "no session snapshot yet (take one with: relaunch snapshot)"
  if ! $diff_mode; then
    if $json_out; then cat "$(last_session_path)"; else
      jq -r '"session snapshot \(.capturedAt)\n", (.windows[] | "  ws \(.workspace)  \(.label)  class=\(.class)")' \
        "$(last_session_path)"
    fi
    return
  fi
  [[ -f "$(last_boot_json_path)" ]] || die "no last-boot log to diff against"
  local report
  report="$(jq -n \
    --argjson before "$(cat "$(last_session_path)")" \
    --argjson after "$(cat "$(last_boot_json_path)")" \
    --argjson now "$(clients_raw)" "$jq_lib"'
      # Live windows keyed by class, carrying the state we care about, so a
      # window that came back on the wrong workspace or with the wrong
      # float/tile state is reported rather than counted as healthy.
      (
        $now
        | map({
            class: match_class,
            workspace: ((.workspace.id // 0) | tonumber),
            floating: (.floating == true)
          })
        | map(select(.class != ""))
      ) as $live
      | [
          $before.windows
          | group_by(.class)[]
          | . as $group
          | ($group[0].class) as $cls
          | ($live | map(select(.class == $cls))) as $back
          | {
              class: $cls,
              label: $group[0].label,
              want: ($group | length),
              live: ($back | length),
              missing: (($group | length) - ($back | length)),
              # A placement is honoured when some returned window of this
              # class sits on the saved workspace with the saved float state.
              placements: [
                $group[]
                | . as $w
                | {
                    wasWorkspace: $w.workspace,
                    wasFloating: $w.floating,
                    matched: (
                      ($back | map(select(
                        .workspace == $w.workspace and .floating == $w.floating
                      )) | length) > 0
                    ),
                    workspaceMatched: (
                      ($back | map(select(.workspace == $w.workspace)) | length) > 0
                    )
                  }
              ]
            }
          | . + {mismatched: ([.placements[] | select(.matched | not)] | length)}
        ]
      | {
          capturedAt: $before.capturedAt,
          bootedAt: ($after.startedAt // ""),
          outcome: ($after.outcome // ""),
          classes: .
        }
    ')"
  if $json_out; then
    printf '%s\n' "$report"
    return
  fi
  jq -r '
    "session before: \(.capturedAt)",
    "last boot:      \(.bootedAt)  outcome: \(.outcome)",
    "",
    (.classes[]
      | . as $c
      | if .missing > 0 then
          "  MISSING  \(.label)  class=\(.class)  had \(.want), back \(.live)"
        elif .mismatched > 0 then
          (
            [.placements[] | select(.matched | not)]
            | map(
                if .workspaceMatched then
                  "float \(.wasFloating)"
                else
                  "ws \(.wasWorkspace)"
                end
              )
            | join(", ")
          ) as $detail
          | "  MOVED    \($c.label)  class=\($c.class)  expected \($detail)"
        else
          "  ok       \(.label)  class=\(.class)  \(.live)/\(.want)"
        end)
  ' <<<"$report"
}

# The hook can no longer be created -- see "Session snapshot -- removed" in
# AGENTS.md -- but it must still be destroyable. An older install may have an
# enabled unit on disk whose ExecStop points at this script; uninstall and
# ensure_hooks both call this to clear it. Best-effort: teardown must never
# block on systemd.
remove_snapshot_hook() {
  local unit
  unit="$(snapshot_unit_path)"
  systemctl --user disable --now omarchy-relaunch-snapshot.service >/dev/null 2>&1 || true
  rm -f "$unit"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
}

arg_value() {
  local flag="$1"
  shift
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "$flag" ]]; then
      printf '%s\n' "${2:-}"
      return 0
    fi
    shift
  done
  return 1
}

cmd_import() {
  local exec ws class cfg pid line source label skeys write_override=false
  exec="$(arg_value --exec "$@" || true)"
  ws="$(arg_value --workspace "$@" || true)"
  class="$(arg_value --class "$@" || true)"
  [[ "$ws" =~ ^[1-9][0-9]*$ ]] || die "import requires --workspace N (N>=1)"
  [[ -n "$class" || -n "$exec" ]] || die "import requires --class or --exec"
  if [[ -n "$class" && -z "$exec" ]]; then
    pid="$(pid_for_running_class "$class" || true)"
    line="$(resolve_launch "$class" "${pid:-}")"
    exec="${line%%$'\t'*}"
    source="${line#*$'\t'}"
  else
    if [[ -z "$class" ]]; then
      class="$(class_for_startup_exec "$exec")"
    fi
    source="overrides-table"
    write_override=true
  fi
  [[ -n "$exec" ]] || die "import could not resolve a launch command for ${class}"
  label="$(display_label_for "$class" "$exec" "$source")"
  skeys="$(startup_keys_json "$class" "$exec" "$source")"
  cfg="$(load_config_json)"
  if jq -e --arg class "$class" '.entries[] | select(.class == $class)' >/dev/null <<<"$cfg"; then
    cfg="$(jq --arg class "$class" --argjson ws "$ws" --arg exec "$exec" --arg src "$source" --arg label "$label" --argjson skeys "$skeys" '
      .entries |= map(if .class == $class then .workspace = $ws | .exec = $exec | .execSource = $src | .label = $label | .startupKeys = $skeys | .enabled = true else . end)
    ' <<<"$cfg")"
  else
    cfg="$(jq --arg class "$class" --argjson ws "$ws" --arg exec "$exec" --arg src "$source" --arg label "$label" --argjson skeys "$skeys" '
      .entries += [{class: $class, workspace: $ws, exec: $exec, execSource: $src, label: $label, startupKeys: $skeys, enabled: true}]
    ' <<<"$cfg")"
  fi
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  if $write_override; then
    set_override_exec "$class" "$exec"
  fi
  jq "$jq_lib"' load_config' <<<"$cfg" | write_generated
  if $json_out; then emit_state; else printf 'Imported %s -> workspace %s\n' "$class" "$ws"; fi
}

cmd_set_exec() {
  local class exec cfg label skeys
  class="$(arg_value --class "$@" || true)"
  exec="$(arg_value --exec "$@" || true)"
  [[ -n "$class" ]] || die "set-exec requires --class"
  [[ -n "$exec" ]] || die "set-exec requires --exec"
  cfg="$(load_config_json)"
  if ! jq -e --arg class "$class" '.entries[] | select(.class == $class)' >/dev/null <<<"$cfg"; then
    die "no relaunch entry for class: $class"
  fi
  label="$(display_label_for "$class" "$exec" "overrides-table")"
  skeys="$(startup_keys_json "$class" "$exec" "overrides-table")"
  cfg="$(jq --arg class "$class" --arg exec "$exec" --arg label "$label" --argjson skeys "$skeys" '
    .entries |= map(if .class == $class then .exec = $exec | .execSource = "overrides-table" | .label = $label | .startupKeys = $skeys else . end)
  ' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  set_override_exec "$class" "$exec"
  jq "$jq_lib"' load_config' <<<"$cfg" | write_generated
  if $json_out; then
    emit_state
  else
    printf 'Set %s exec to %s\n' "$class" "$exec"
  fi
}

cmd_drop() {
  local class cfg
  class="$(arg_value --class "$@" || true)"
  [[ -n "$class" ]] || die "drop requires --class"
  cfg="$(load_config_json)"
  cfg="$(jq --arg class "$class" '.entries |= map(select(.class != $class))' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  unset_override_exec "$class"
  jq "$jq_lib"' load_config' <<<"$cfg" | write_generated
  if $json_out; then emit_state; else printf 'Removed %s from relaunch\n' "$class"; fi
}

cmd_drop_startup() {
  local id kind exec file tmp kept=0
  id="$(arg_value --id "$@" || true)"
  [[ -n "$id" ]] || die "drop-startup requires --id"
  kind="${id#*:}"
  kind="${kind%%:*}"
  exec="${id#*:}"
  exec="${exec#*:}"
  file="$(autostart_path)"
  [[ -f "$file" ]] || die "no autostart file: $file"
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*-- ]]; then
      printf '%s\n' "$line" >>"$tmp"
      continue
    fi
    if [[ "$kind" == launch_on_start && "$line" =~ o\.launch_on_start\([[:space:]]*\"([^\"]+)\" && "${BASH_REMATCH[1]}" == "$exec" ]]; then
      kept=1
      continue
    fi
    if [[ "$kind" == exec_on_start && "$line" =~ o\.exec_on_start\([[:space:]]*\"([^\"]+)\" && "${BASH_REMATCH[1]}" == "$exec" ]]; then
      kept=1
      continue
    fi
    printf '%s\n' "$line" >>"$tmp"
  done <"$file"
  [[ "$kept" == 1 ]] || die "startup line not found: $id"
  mv -f "$tmp" "$file"
  if $json_out; then emit_state; else printf 'Deleted startup config: %s\n' "$exec"; fi
}

cmd_ignore() {
  local id cfg
  id="$(arg_value --id "$@" || true)"
  [[ -n "$id" ]] || die "ignore requires --id"
  cfg="$(load_config_json)"
  cfg="$(jq --arg id "$id" '.ignored = ((.ignored // []) + [$id] | unique)' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  if $json_out; then emit_state; else printf 'Ignoring startup config: %s\n' "$id"; fi
}

cmd_unignore() {
  local id cfg
  id="$(arg_value --id "$@" || true)"
  [[ -n "$id" ]] || die "unignore requires --id"
  cfg="$(load_config_json)"
  cfg="$(jq --arg id "$id" '.ignored = [(.ignored // [])[] | select(. != $id)]' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  if $json_out; then emit_state; else printf 'No longer ignoring: %s\n' "$id"; fi
}

cmd_boot_skip() {
  set_skip_once true
  load_config_json | write_generated
  if $json_out; then emit_state; else printf 'Relaunch will skip the next boot.\n'; fi
}

cmd_boot_disable() {
  mkdir -p "$(config_dir)"
  : >"$(disabled_path)"
  set_skip_once false
  load_config_json | write_generated
  if $json_out; then emit_state; else printf 'Relaunch disabled until re-enabled.\n'; fi
}

cmd_boot_enable() {
  rm -f "$(disabled_path)"
  set_skip_once false
  load_config_json | write_generated
  if $json_out; then emit_state; else printf 'Relaunch enabled on boot.\n'; fi
}

# One-line Hyprland hook. io.open-then-dofile so a missing relaunch.lua
# (uninstall, first boot before generate) is not a Hyprland config error.
hyprland_hook_line() {
  printf '%s\n' 'local _rl = (os.getenv("XDG_CONFIG_HOME") or (os.getenv("HOME") .. "/.config")) .. "/omarchy-relaunch/relaunch.lua"; local _f = io.open(_rl); if _f then _f:close(); dofile(_rl) end'
}

remove_managed_block() {
  local file="$1" real tmp
  [[ -e "$file" ]] || return 0
  real="$(resolve_write_target "$file")"
  [[ -f "$real" ]] || return 0
  # Beside the resolved target, not mktemp's /tmp: a cross-filesystem mv is
  # a copy plus unlink, so it is neither atomic nor symlink-preserving.
  tmp="${real}.rl.tmp"
  # Drop only our marker comment and the immediately following line when
  # that line is our hook (relaunch boot) or our dofile. Never eat the next
  # user launch/source line just because it sits under the comment.
  awk '
    /^[[:space:]]*-- omarchy-relaunch/ { pending=1; next }
    pending {
      pending=0
      if ($0 ~ /relaunch boot/ || $0 ~ /omarchy-relaunch\/relaunch\.lua/) next
    }
    { print }
  ' "$real" >"$tmp" || { rm -f "$tmp"; die "could not rewrite $real"; }
  mv -f "$tmp" "$real"
}

cmd_uninstall() {
  local yes=false a
  for a in "$@"; do
    [[ "$a" == --yes ]] && yes=true
  done
  $yes || die "uninstall requires --yes"
  # Disable the snapshot unit FIRST, while the script and config dir still
  # exist: `disable --now` fires ExecStop, which runs `relaunch snapshot`.
  # Tearing down the files first would leave an enabled unit whose ExecStop
  # points at a deleted binary, and would let that ExecStop recreate the
  # config dir that uninstall had just removed.
  remove_snapshot_hook
  remove_managed_block "$(autostart_path)"
  remove_managed_block "$(hyprland_lua_path)"
  remove_legacy_conf
  rm -rf "$(config_dir)"
  local bin="${PREFIX:-$HOME/.local}/bin/relaunch"
  if [[ -f "$bin" ]] && grep -q 'omarchy-relaunch bar widget' "$bin"; then
    rm -f "$bin"
  fi
  # Emit the result before unlinking the plugin checkout. The bar panel
  # loads these QML files; deleting them first makes the popup vanish
  # with no "removed" message.
  if $json_out; then
    jq -n '{ok: true, uninstalled: true}'
    ( sleep 2; rm -rf "$(plugin_dir)" ) &
  else
    rm -rf "$(plugin_dir)"
    printf 'Relaunch removed.\n'
  fi
}

# One awk pass reporting everything the repair decision needs: how many
# copies of the exact hook line, how many lines invoke `relaunch boot` at all
# (managed or hand-written), and how many managed markers. One fork per file,
# the same as the single grep this replaced -- ensure_hooks runs on every
# list and save, and #13/#16 took that path from 18.3s to 0.5s.
hook_counts() {
  local hook="$1" file="$2"
  awk -v hook="$hook" '
    index($0, hook) { exact++ }
    /relaunch[[:space:]]+boot/ { anyboot++ }
    /^[[:space:]]*--[[:space:]]*omarchy-relaunch/ { marker++ }
    END { printf "%d %d %d\n", exact + 0, anyboot + 0, marker + 0 }
  ' "$file" 2>/dev/null || printf '0 0 0\n'
}

# Strip every line that invokes `relaunch boot`, plus our marker comments.
# remove_managed_block only removes a marker and the hook directly under it,
# which leaves a hand-written unmarked hook in place -- and that one launches
# every entry a second time. Repair needs both gone before re-appending, so
# the result is exactly one.
remove_all_boot_hooks() {
  local file="$1" real tmp
  [[ -e "$file" ]] || return 0
  real="$(resolve_write_target "$file")"
  [[ -f "$real" ]] || return 0
  tmp="${real}.rl.tmp"
  awk '
    /^[[:space:]]*--[[:space:]]*omarchy-relaunch/ { next }
    /relaunch[[:space:]]+boot/ { next }
    { print }
  ' "$real" >"$tmp" || { rm -f "$tmp"; die "could not rewrite $real"; }
  mv -f "$tmp" "$real"
}

ensure_hooks() {
  local auto lua bin hook boot_hook counts exact anyboot marker
  auto="$(autostart_path)"
  lua="$(hyprland_lua_path)"
  hook="$(hyprland_hook_line)"
  boot_hook="o.exec_on_start(\"${SELF} boot\")"
  mkdir -p "$(dirname "$auto")" "$(dirname "$lua")" "$(config_dir)"
  ensure_overrides_file
  remove_legacy_conf
  # Create the rules file before touching hyprland.lua. Hyprland reloads
  # as soon as that file changes; dofile of a missing path is a hard error.
  [[ -f "$(lua_path)" ]] || printf 'return\n' >"$(lua_path)"

  # A missing file is not a reason to skip wiring: a fresh config would
  # silently get no hook at all. Redirection writes *through* a symlink, so
  # creating and appending are both link-safe; only a rename is not.
  [[ -e "$auto" ]] || printf '%s\n' '-- Extra autostart processes.' >"$auto"
  [[ -e "$lua" ]] || printf '%s\n' '-- Hyprland configuration.' >"$lua"

  # Correct means exactly one of our hook, no other `relaunch boot` line, and
  # exactly one marker. Anything else -- a marker whose hook was deleted, a
  # malformed line under the marker, a stray hand-written hook, or duplicates
  # from a moved SELF -- is repaired the same way: strip them all, append one.
  read -r exact anyboot marker <<<"$(hook_counts "$boot_hook" "$auto")"
  if [[ "$exact" != 1 || "$anyboot" != 1 || "$marker" != 1 ]]; then
    remove_all_boot_hooks "$auto"
    {
      printf '\n'
      printf '%s\n' '-- omarchy-relaunch (managed; hidden from the Relaunch list)'
      printf '%s\n' "$boot_hook"
    } >>"$auto"
  fi

  if ! grep -Fq "$hook" "$lua"; then
    remove_managed_block "$lua"
    {
      printf '\n'
      printf '%s\n' '-- omarchy-relaunch'
      printf '%s\n' "$hook"
    } >>"$lua"
  fi

  # Upgrade path for the withdrawn snapshot hook. An install that ran
  # `snapshot-hook --enable` before it was removed still has an enabled unit
  # whose ExecStop fires at every logout, and that user will never run
  # `uninstall`. Clear it here instead.
  #
  # The `[[ -f ]]` guard is the whole point: ensure_hooks runs on every list
  # and save, and remove_snapshot_hook shells out to systemctl twice. Without
  # the guard this would put two forks back on the hot path that #13 spent a
  # PR clearing. With it, the normal case is one stat of a file that does not
  # exist.
  if [[ -f "$(snapshot_unit_path)" ]]; then
    remove_snapshot_hook
  fi

  # Plugin-manager installs do not put the script on PATH. Copy it so a
  # terminal `relaunch` works, but skip that when tests override the config dir.
  if [[ -z "${RELAUNCH_CONFIG_DIR:-}" ]]; then
    bin="${PREFIX:-$HOME/.local}/bin/relaunch"
    mkdir -p "$(dirname "$bin")"
    if [[ ! -e "$bin" ]] || ! cmp -s "$SELF" "$bin"; then
      install -m 0755 "$SELF" "$bin"
    fi
  fi
}

usage() {
  cat <<'EOF'
relaunch — engine for omarchy-relaunch

  relaunch save [--json]                 capture running layout
  relaunch generate [--json]             rebuild rules from config
  relaunch list [--json]                 relaunch + startup inventory
  relaunch reload                        hyprctl reload
  relaunch boot                          hidden autostart hook
  relaunch last-boot [--json] [--open]
  relaunch snapshot                      capture the layout now (diagnostic)
  relaunch last-session [--json] [--diff]   compare that snapshot with the boot
  relaunch import --class CLASS --workspace N
  relaunch import --exec CMD --workspace N
  relaunch set-exec --class CLASS --exec CMD
  relaunch drop --class CLASS            remove from relaunch list
  relaunch drop-startup --id ID          delete the Hyprland startup line
  relaunch ignore --id ID                leave startup alone, remember it
  relaunch unignore --id ID
  relaunch boot-skip                     skip relaunch on the next boot
  relaunch boot-disable                  disable until re-enabled
  relaunch boot-enable
  relaunch uninstall --yes               remove relaunch permanently

config:  ~/.config/omarchy-relaunch/config.json
rules:   ~/.config/omarchy-relaunch/relaunch.lua
EOF
}

main() {
  need_jq
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi
  local cmd="$1"
  shift
  if has_json_flag "$@"; then
    json_out=true
  fi
  case "$cmd" in
    save) cmd_save ;;
    generate) cmd_generate ;;
    list) cmd_list ;;
    reload) cmd_reload ;;
    boot) cmd_boot ;;
    last-boot) cmd_last_boot "$@" ;;
    snapshot) cmd_snapshot ;;
    last-session) cmd_last_session "$@" ;;
    import) cmd_import "$@" ;;
    set-exec) cmd_set_exec "$@" ;;
    drop) cmd_drop "$@" ;;
    drop-startup) cmd_drop_startup "$@" ;;
    ignore) cmd_ignore "$@" ;;
    unignore) cmd_unignore "$@" ;;
    boot-skip) cmd_boot_skip ;;
    boot-disable) cmd_boot_disable ;;
    boot-enable) cmd_boot_enable ;;
    uninstall) cmd_uninstall "$@" ;;
    ensure-hooks) ensure_hooks ;;
    -h | --help | help) usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
