#!/usr/bin/env bash
# relaunch — engine for the omarchy-relaunch bar widget.
# Inventories running windows and existing Hyprland startup apps, then
# generates workspace-pin rules. App launches happen from `relaunch boot`
# (a hidden autostart hook), so this script can skip or disable itself.
set -euo pipefail

HYPRCTL="${HYPRCTL:-hyprctl}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

config_dir() {
  if [[ -n "${RELAUNCH_CONFIG_DIR:-}" ]]; then
    printf '%s\n' "$RELAUNCH_CONFIG_DIR"
    return
  fi
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-relaunch"
}

config_path() { printf '%s\n' "$(config_dir)/config.json"; }
overrides_path() { printf '%s\n' "$(config_dir)/overrides.json"; }
snippet_path() { printf '%s\n' "$(config_dir)/relaunch.conf"; }
lua_path() { printf '%s\n' "$(config_dir)/relaunch.lua"; }
disabled_path() { printf '%s\n' "$(config_dir)/disabled"; }
skip_path() { printf '%s\n' "$(config_dir)/skip-once"; }
last_boot_log_path() { printf '%s\n' "$(config_dir)/last-boot.log"; }
last_boot_json_path() { printf '%s\n' "$(config_dir)/last-boot.json"; }

autostart_path() {
  printf '%s\n' "${RELAUNCH_AUTOSTART:-$HOME/.config/hypr/autostart.lua}"
}

hyprland_lua_path() {
  printf '%s\n' "${RELAUNCH_HYPRLAND_LUA:-$HOME/.config/hypr/hyprland.lua}"
}

plugin_dir() {
  printf '%s\n' "${RELAUNCH_PLUGIN_DIR:-$HOME/.config/omarchy/plugins/io.github.laytonf.relaunch}"
}

json_out=false

has_json_flag() {
  local a
  for a in "$@"; do
    [[ "$a" == --json ]] && return 0
  done
  return 1
}

die() {
  local msg="$1"
  if $json_out; then
    jq -n --arg error "$msg" '{ok: false, error: $error}'
  else
    printf 'error: %s\n' "$msg" >&2
  fi
  exit 1
}

need_jq() {
  command -v jq >/dev/null 2>&1 || die "jq not found (required; ships with Omarchy)"
}

# Shared jq helpers. Launch commands are resolved in bash (terminal wrap,
# overrides.json, .desktop, cmdline). guess_exec is the last-resort class fold.
jq_lib='
def guess_exec:
  ascii_downcase;

def known_exec_sources:
  ["terminal", "overrides-table", "desktop-file", "cmdline", "guess"];

def normalize_exec_source:
  if (known_exec_sources | index(.)) != null then . else "" end;

def match_class:
  if ((.initialClass // "") != "") then .initialClass else (.class // "") end;

def regex_escape:
  gsub("\\\\"; "\\\\")
  | gsub("\\."; "\\.")
  | gsub("\\+"; "\\+")
  | gsub("\\*"; "\\*")
  | gsub("\\?"; "\\?")
  | gsub("\\("; "\\(")
  | gsub("\\)"; "\\)")
  | gsub("\\["; "\\[")
  | gsub("\\]"; "\\]")
  | gsub("\\{"; "\\{")
  | gsub("\\}"; "\\}")
  | gsub("\\^"; "\\^")
  | gsub("\\$"; "\\$")
  | gsub("\\|"; "\\|");

# Hyprland regex backslashes must be doubled again for Lua "..." strings.
# Otherwise org.omarchy.agent becomes "org\.omarchy" and Lua errors on \o.
def lua_regex:
  regex_escape | gsub("\\\\"; "\\\\") | gsub("\""; "\\\"");

def normalize_entry:
  {
    class: (.class // ""),
    workspace: ((.workspace // 0) | tonumber),
    exec: (.exec // ""),
    execSource: ((.execSource // "") | normalize_exec_source),
    enabled: (.enabled == true)
  }
  + (if .float == true then {float: true} else {} end);

def load_config:
  {
    staggerSeconds: ((.staggerSeconds // 0) | tonumber),
    ignored: ((.ignored // []) | map(tostring)),
    skipOnce: (.skipOnce == true),
    entries: ((.entries // []) | map(normalize_entry))
  };

def dump_config:
  {
    staggerSeconds: .staggerSeconds,
    ignored: (.ignored // []),
    skipOnce: (.skipOnce == true),
    entries: ([.entries[] | normalize_entry] | sort_by(.workspace, .class))
  };

def capture($clients):
  load_config as $cfg
  | ($cfg.entries) as $old
  | ([ $old[] | {key: .class, value: .} ] | from_entries) as $by0
  | (
      $clients
      | map(. + {match: match_class})
      | map(select(.match != "" and ((.workspace.id // 0) >= 1)))
      | sort_by(.workspace.id, .match)
    ) as $cs
  | reduce $cs[] as $cl (
      {by: $by0, added: 0, updated: 0, order: [$old[].class], seen: {}};
      if .seen[$cl.match] then .
      else
        .seen[$cl.match] = true
        | if .by[$cl.match] then
            if .by[$cl.match].workspace != $cl.workspace.id then
              .by[$cl.match].workspace = $cl.workspace.id
              | .updated += 1
            else . end
            | (
                (.by[$cl.match].execSource | normalize_exec_source) as $src
                | (($cl.relaunchExecSource // "") | normalize_exec_source) as $nsrc
                | (($cl.relaunchExec // "") != "")
                  and ($nsrc == "terminal" or $nsrc == "overrides-table" or $nsrc == "desktop-file")
                  and (
                    $src == "guess" or $src == "cmdline"
                    or ($src == "" and .by[$cl.match].exec == ($cl.match | ascii_downcase))
                  )
              ) as $heal
            | if $heal then
                .by[$cl.match].exec = $cl.relaunchExec
                | .by[$cl.match].execSource = $cl.relaunchExecSource
                | .updated += 1
              else . end
          else
            .by[$cl.match] = (
              {
                class: $cl.match,
                workspace: $cl.workspace.id,
                exec: (if ($cl.relaunchExec // "") != "" then $cl.relaunchExec else ($cl.match | guess_exec) end),
                execSource: (
                  if ($cl.relaunchExecSource // "") != "" then $cl.relaunchExecSource
                  elif ($cl.relaunchExec // "") != "" then "guess"
                  else "guess"
                  end
                ),
                enabled: true
              }
              + (if $cl.floating == true then {float: true} else {} end)
            )
            | .order += [$cl.match]
            | .added += 1
          end
      end
    )
  | {
      staggerSeconds: $cfg.staggerSeconds,
      ignored: $cfg.ignored,
      skipOnce: $cfg.skipOnce,
      entries: [ .order[] as $c | .by[$c] ],
      added, updated
    };

def enabled_entries:
  load_config
  | .entries
  | map(select(.enabled and .class != "" and .workspace > 0))
  | sort_by(.workspace, .class);

def lua_rules:
  enabled_entries
  | map(
      "o.window({ class = \"^(\(.class | lua_regex))$\" }, { workspace = \"\(.workspace) silent\""
      + (if .float == true then ", float = true" else "" end)
      + " })\n"
    )
  | add // "";
'

load_config_json() {
  local path
  path="$(config_path)"
  if [[ ! -f "$path" ]]; then
    printf '%s\n' '{"staggerSeconds":0,"ignored":[],"entries":[]}'
    return
  fi
  jq -e "$jq_lib"' load_config' "$path" || die "parse config: $path"
}

atomic_write() {
  local dest="$1"
  local tmp="${dest}.tmp"
  mkdir -p "$(dirname "$dest")"
  cat >"$tmp"
  mv -f "$tmp" "$dest"
}

config_skip_once() {
  local p
  p="$(config_path)"
  [[ -f "$p" ]] && jq -e '.skipOnce == true' "$p" >/dev/null 2>&1
}

boot_gated() {
  [[ -f "$(disabled_path)" || -f "$(skip_path)" ]] && return 0
  config_skip_once
}

set_skip_once() {
  local on="$1" cfg
  mkdir -p "$(config_dir)"
  if [[ "$on" == true ]]; then
    : >"$(skip_path)"
  else
    rm -f "$(skip_path)"
  fi
  cfg="$(load_config_json)"
  cfg="$(jq --argjson on "$on" '.skipOnce = $on' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
}

write_config_from_json() {
  jq "$jq_lib"' dump_config' | atomic_write "$(config_path)"
}

remove_legacy_conf() {
  # Older installs wrote windowrulev2 to relaunch.conf and sourced it from
  # hyprland.conf. Pins now live only in relaunch.lua; drop the leftover
  # file and source line so both install paths stay on one mechanism.
  rm -f "$(snippet_path)" "$(snippet_path).tmp"
  local hypr_conf="${RELAUNCH_HYPR_CONF:-$HOME/.config/hypr/hyprland.conf}" tmp
  [[ -f "$hypr_conf" ]] || return 0
  if grep -qF "source = $(snippet_path)" "$hypr_conf" || grep -qx '# omarchy-relaunch' "$hypr_conf"; then
    tmp="$(mktemp)"
    grep -vF "source = $(snippet_path)" "$hypr_conf" | grep -vx '# omarchy-relaunch' >"$tmp" || true
    mv -f "$tmp" "$hypr_conf"
  fi
}

write_generated() {
  local cfg gated=false
  cfg="$(cat)"
  if boot_gated; then gated=true; fi
  remove_legacy_conf
  {
    cat <<'LUA'
-- Generated by omarchy-relaunch. Do not edit by hand.
-- Regenerated by: relaunch generate
local cfg = os.getenv("XDG_CONFIG_HOME")
if cfg == nil or cfg == "" then
  cfg = os.getenv("HOME") .. "/.config"
end
local dir = cfg .. "/omarchy-relaunch"
local function exists(path)
  local f = io.open(path, "r")
  if f ~= nil then f:close(); return true end
  return false
end
if exists(dir .. "/disabled") or exists(dir .. "/skip-once") then
  return
end
LUA
    if $gated; then
      printf '%s\n' '-- skip/disable armed; relaunch boot restores rules when the flag is cleared'
    else
      jq -r "$jq_lib"' lua_rules' <<<"$cfg"
    fi
  } | atomic_write "$(lua_path)"
}

split_exec_words() {
  # Split an exec string on IFS without pathname expansion.
  local _s="$1"
  local -n _out="$2"
  set -f
  # shellcheck disable=SC2206
  _out=($_s)
  set +f
}

is_relaunch_exec() {
  local exec="$1" token base
  local -a words=()
  [[ "$exec" == *omarchy-relaunch* ]] && return 0
  split_exec_words "$exec" words
  token="${words[0]:-}"
  token="${token##*/}"
  [[ "$token" == relaunch ]] && return 0
  for token in "${words[@]}"; do
    base="${token##*/}"
    [[ "$base" == relaunch ]] && return 0
  done
  return 1
}

is_wrapper_cmd() {
  case "${1##*/}" in
    setsid | env | command | nice | nohup | uwsm-app) return 0 ;;
  esac
  return 1
}

is_terminal_cmd() {
  local b="${1##*/}"
  case "$b" in
    foot | alacritty | kitty | wezterm | wezterm-gui | ghostty | xdg-terminal-exec)
      return 0
      ;;
  esac
  [[ "$b" == omarchy-launch-terminal* ]]
}

is_generic_terminal_class() {
  case "$1" in
    foot | alacritty | kitty | wezterm | wezterm-gui | ghostty | xdg-terminal-exec)
      return 0
      ;;
  esac
  return 1
}

# Print JSON {wrapped, class, exec} from argv. A terminal hosting another
# command (foot -e herdr, omarchy-launch-terminal nvim) becomes class=that
# command and exec=xdg-terminal-exec --app-id=<class> <command...>, so the
# next launch has a distinct Hyprland class. No per-app special cases.
identity_from_argv() {
  local -a argv=("$@")
  local i=0 n=${#argv[@]}
  local app_id="" terminal=""
  local -a inner=()

  while ((i < n)) && { is_wrapper_cmd "${argv[i]}" || [[ "${argv[i]}" == -- ]] || [[ "${argv[i]}" == [A-Za-z_]*[=]* && "${argv[i]}" != --* ]]; }; do
    ((i++)) || true
  done

  if ((i < n)) && is_terminal_cmd "${argv[i]}"; then
    terminal="${argv[i]##*/}"
    ((i++)) || true
    while ((i < n)); do
      local a="${argv[i]}"
      if [[ "$a" == --app-id=* ]]; then
        app_id="${a#--app-id=}"
        ((i++)) || true
      elif [[ "$a" == --app-id && $((i + 1)) -lt $n ]]; then
        app_id="${argv[i + 1]}"
        i=$((i + 2))
      elif [[ "$a" == -e || "$a" == --command || "$a" == -- ]]; then
        inner=("${argv[@]:i+1}")
        break
      elif [[ "$a" == --working-directory || "$a" == --dir || "$a" == -D || "$a" == --title ]]; then
        i=$((i + 2))
      elif [[ "$a" == --working-directory=* || "$a" == --dir=* || "$a" == --title=* ]]; then
        ((i++)) || true
      elif [[ "$a" == -* ]]; then
        ((i++)) || true
      else
        inner=("${argv[@]:i}")
        break
      fi
    done
  fi

  local class="" exec=""
  if [[ -n "$app_id" ]] && ! is_generic_terminal_class "$app_id"; then
    class="$app_id"
    if ((${#inner[@]} > 0)); then
      exec="xdg-terminal-exec --app-id=${class} ${inner[*]}"
    else
      exec="xdg-terminal-exec --app-id=${class}"
    fi
  elif ((${#inner[@]} > 0)); then
    class="${inner[0]##*/}"
    exec="xdg-terminal-exec --app-id=${class} ${inner[*]}"
  fi

  if [[ -n "$class" ]]; then
    jq -n --arg class "$class" --arg exec "$exec" '{wrapped: true, class: $class, exec: $exec}'
  else
    jq -n '{wrapped: false}'
  fi
}

read_pid_argv() {
  local pid="$1" file arg
  local -n _argv="$2"
  _argv=()
  if [[ -n "${RELAUNCH_CMDLINE_DIR:-}" ]]; then
    file="${RELAUNCH_CMDLINE_DIR}/${pid}"
  else
    file="/proc/${pid}/cmdline"
  fi
  [[ -r "$file" ]] || return 1
  while IFS= read -r -d '' arg; do
    _argv+=("$arg")
  done <"$file"
  ((${#_argv[@]} > 0))
}

ppid_of() {
  local pid="$1" file
  if [[ -n "${RELAUNCH_CMDLINE_DIR:-}" ]]; then
    file="${RELAUNCH_CMDLINE_DIR}/${pid}.ppid"
    if [[ -r "$file" ]]; then
      tr -d '[:space:]' <"$file"
      return
    fi
    printf '0\n'
    return
  fi
  awk '/^PPid:/{print $2; exit}' "/proc/${pid}/status" 2>/dev/null || printf '0\n'
}

identity_from_pid() {
  local pid="$1" hops=0 next
  local -a argv=()
  local ident
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || { jq -n '{wrapped: false}'; return; }
  while [[ "$pid" =~ ^[1-9][0-9]*$ ]] && ((hops < 8)); do
    if read_pid_argv "$pid" argv; then
      ident="$(identity_from_argv "${argv[@]}")"
      if jq -e '.wrapped == true' >/dev/null <<<"$ident"; then
        printf '%s\n' "$ident"
        return
      fi
    fi
    next="$(ppid_of "$pid")"
    [[ "$next" == "$pid" || "$next" == 0 ]] && break
    pid="$next"
    hops=$((hops + 1))
  done
  jq -n '{wrapped: false}'
}

normalize_desktop_key() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -s ' _.' '-'
}

desktop_launch_cmd() {
  local file="$1" id
  if command -v gio >/dev/null 2>&1; then
    printf 'gio launch %q\n' "$file"
    return
  fi
  if command -v gtk-launch >/dev/null 2>&1; then
    id="$(basename "$file" .desktop)"
    printf 'gtk-launch %q\n' "$id"
    return
  fi
  return 1
}

index_set_if_empty() {
  local -n _map="$1"
  local key="$2" val="$3"
  [[ -n "$key" && -n "$val" ]] || return 0
  [[ -n "${_map[$key]:-}" ]] && return 0
  _map["$key"]="$val"
}

xdg_application_dirs() {
  local d xdg
  local -a dirs=()
  if [[ -n "${RELAUNCH_DATA_DIRS:-}" ]]; then
    IFS=: read -r -a dirs <<<"$RELAUNCH_DATA_DIRS"
    for d in "${dirs[@]}"; do
      [[ -d "$d/applications" ]] && printf '%s\n' "$d/applications"
      [[ -d "$d" && "${d##*/}" == applications ]] && printf '%s\n' "$d"
    done
    return
  fi
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  xdg="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  IFS=: read -r -a dirs <<<"$xdg"
  for d in "${dirs[@]}"; do
    [[ -d "$d/applications" ]] && printf '%s\n' "$d/applications"
  done
}

declare -A DESKTOP_EXEC_BY_CLASS=()
declare -A DESKTOP_EXEC_BY_ID=()
declare -A DESKTOP_EXEC_BY_NAME=()
declare -A DESKTOP_CLASS_BY_EXEC=()
_desktop_indexed=0

index_desktop_file() {
  local file="$1"
  local section="" raw_exec="" wmclass="" name="" hidden=false
  local line key val id launch
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ "$line" == \[*] ]]; then
      section="$line"
      continue
    fi
    [[ "$section" == "[Desktop Entry]" ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      Hidden|hidden) [[ "${val,,}" == true ]] && hidden=true ;;
      Exec) [[ -z "$raw_exec" ]] && raw_exec="$val" ;;
      StartupWMClass) wmclass="$val" ;;
      Name) [[ -z "$name" ]] && name="$val" ;;
    esac
  done <"$file"
  $hidden && return 0
  [[ -n "$raw_exec" ]] || return 0
  launch="$(desktop_launch_cmd "$file")" || return 0
  id="$(basename "$file" .desktop)"
  index_set_if_empty DESKTOP_EXEC_BY_CLASS "$(normalize_desktop_key "$wmclass")" "$launch"
  index_set_if_empty DESKTOP_EXEC_BY_ID "$(normalize_desktop_key "$id")" "$launch"
  index_set_if_empty DESKTOP_EXEC_BY_NAME "$(normalize_desktop_key "$name")" "$launch"
  # Reverse map uses the raw Exec token so startup-line matching still works.
  index_set_if_empty DESKTOP_CLASS_BY_EXEC "$(normalize_desktop_key "$raw_exec")" "${wmclass:-$id}"
  index_set_if_empty DESKTOP_CLASS_BY_EXEC "$(normalize_desktop_key "${raw_exec%% *}")" "${wmclass:-$id}"
}

ensure_desktop_index() {
  local dir f
  ((_desktop_indexed)) && return 0
  _desktop_indexed=1
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    while IFS= read -r -d '' f; do
      index_desktop_file "$f"
    done < <(find "$dir" -maxdepth 2 -type f -name '*.desktop' -print0 2>/dev/null)
  done < <(xdg_application_dirs)
}

desktop_exec_for_class() {
  local k
  ensure_desktop_index
  k="$(normalize_desktop_key "$1")"
  # Spec order: StartupWMClass, then Name, then desktop-file id.
  printf '%s\n' "${DESKTOP_EXEC_BY_CLASS[$k]:-${DESKTOP_EXEC_BY_NAME[$k]:-${DESKTOP_EXEC_BY_ID[$k]:-}}}"
}

desktop_class_for_exec() {
  local k
  ensure_desktop_index
  k="$(normalize_desktop_key "$1")"
  printf '%s\n' "${DESKTOP_CLASS_BY_EXEC[$k]:-${DESKTOP_CLASS_BY_EXEC[$(normalize_desktop_key "${1%% *}")]:-}}"
}

is_helper_argv() {
  local a
  [[ "${1##*/}" == *crashpad* || "${1##*/}" == oosplash ]] && return 0
  for a in "$@"; do
    case "$a" in
      --type=renderer|--type=zygote|--type=gpu-process|--type=utility|--type=plugin)
        return 0
        ;;
    esac
  done
  return 1
}

cmdline_exec_for_pid() {
  local pid="$1" hops=0 next
  local -a argv=()
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  while [[ "$pid" =~ ^[1-9][0-9]*$ ]] && ((hops < 8)); do
    if read_pid_argv "$pid" argv && ((${#argv[@]} > 0)); then
      if ! is_helper_argv "${argv[@]}"; then
        printf '%s\n' "${argv[*]}"
        return 0
      fi
    fi
    next="$(ppid_of "$pid")"
    [[ "$next" == "$pid" || "$next" == 0 ]] && break
    pid="$next"
    hops=$((hops + 1))
  done
  return 1
}

class_for_startup_exec() {
  local exec="$1" ident class mapped first="" token base
  local -a argv=()
  split_exec_words "$exec" argv
  ident="$(identity_from_argv "${argv[@]}")"
  class="$(jq -r 'if .wrapped then .class else empty end' <<<"$ident")"
  if [[ -n "$class" ]]; then
    printf '%s\n' "$class"
    return
  fi
  mapped="$(desktop_class_for_exec "$exec")"
  if [[ -n "$mapped" ]]; then
    printf '%s\n' "$mapped"
    return
  fi
  for token in "${argv[@]}"; do
    [[ "$token" == -* || "$token" == -- ]] && continue
    [[ "$token" == *=* ]] && continue
    base="${token##*/}"
    is_wrapper_cmd "$base" && continue
    [[ -z "$first" ]] && first="$base"
    mapped="$(desktop_class_for_exec "$base")"
    if [[ -n "$mapped" && "$mapped" != "$base" ]]; then
      printf '%s\n' "$mapped"
      return
    fi
  done
  printf '%s\n' "${first:-${argv[0]:-}}"
}

ensure_overrides_file() {
  local p
  p="$(overrides_path)"
  mkdir -p "$(config_dir)"
  if [[ ! -f "$p" ]]; then
    printf '{}\n' >"$p"
  fi
}

load_overrides_json() {
  local p
  ensure_overrides_file
  p="$(overrides_path)"
  jq -e 'if type == "object" then . else {} end' "$p" 2>/dev/null || printf '{}\n'
}

override_exec_for_class() {
  local class="$1"
  load_overrides_json | jq -r --arg c "$class" '
    to_entries
    | map(select((.key | ascii_downcase) == ($c | ascii_downcase)))
    | .[0].value // empty
  '
}

set_override_exec() {
  local class="$1" exec="$2" json
  ensure_overrides_file
  json="$(load_overrides_json | jq --arg c "$class" --arg e "$exec" '
    with_entries(select((.key | ascii_downcase) != ($c | ascii_downcase)))
    + {($c): $e}
  ')"
  printf '%s\n' "$json" | atomic_write "$(overrides_path)"
}

exec_is_ok() {
  local exec="$1" token
  token="${exec%% *}"
  [[ -n "$token" ]] || return 1
  command -v "$token" >/dev/null 2>&1 && return 0
  [[ -x "$token" ]]
}

resolve_launch() {
  # Prints: exec<TAB>source
  local class="$1" pid="$2"
  local ident exec
  ident="$(identity_from_pid "$pid")"
  if jq -e '.wrapped == true' >/dev/null <<<"$ident"; then
    jq -r '[.exec, "terminal"] | @tsv' <<<"$ident"
    return
  fi
  exec="$(override_exec_for_class "$class")"
  if [[ -n "$exec" ]]; then
    printf '%s\t%s\n' "$exec" "overrides-table"
    return
  fi
  exec="$(desktop_exec_for_class "$class")"
  if [[ -n "$exec" ]]; then
    printf '%s\t%s\n' "$exec" "desktop-file"
    return
  fi
  exec="$(cmdline_exec_for_pid "$pid" || true)"
  if [[ -n "$exec" ]]; then
    printf '%s\t%s\n' "$exec" "cmdline"
    return
  fi
  printf '%s\t%s\n' "$(printf '%s' "$class" | tr '[:upper:]' '[:lower:]')" "guess"
}

annotate_clients() {
  local clients="$1" pid class exec source patches line
  patches='[]'
  while IFS=$'\t' read -r pid class; do
    [[ -z "$pid" || "$pid" == null ]] && continue
    line="$(resolve_launch "$class" "$pid")"
    exec="${line%%$'\t'*}"
    source="${line#*$'\t'}"
    if [[ "$source" == terminal ]]; then
      ident="$(identity_from_pid "$pid")"
      patches="$(jq --argjson pid "$pid" --argjson ident "$ident" --arg exec "$exec" \
        '. + [{pid: $pid, wrapped: true, class: $ident.class, exec: $exec, execSource: "terminal"}]' <<<"$patches")"
      continue
    fi
    patches="$(jq --argjson pid "$pid" --arg class "$class" --arg exec "$exec" --arg src "$source" \
      '. + [{pid: $pid, wrapped: false, class: $class, exec: $exec, execSource: $src}]' <<<"$patches")"
  done < <(jq -r '
    .[] | select(.pid != null)
    | [
        (.pid | tostring),
        (if (.initialClass // "") != "" then .initialClass else (.class // "") end)
      ] | @tsv
  ' <<<"$clients")
  if [[ "$patches" == "[]" ]]; then
    printf '%s\n' "$clients"
    return
  fi
  jq --argjson patches "$patches" '
    ($patches | map({key: (.pid | tostring), value: .}) | from_entries) as $by
    | map(
        (($by[(.pid | tostring)]) // null) as $p
        | if $p == null then .
          elif $p.wrapped == true then
            .class = $p.class
            | .initialClass = $p.class
            | .relaunchExec = $p.exec
            | .relaunchExecSource = $p.execSource
          else
            .relaunchExec = $p.exec
            | .relaunchExecSource = $p.execSource
          end
      )
  ' <<<"$clients"
}

scan_startup() {
  local file line kind exec id class n=0
  file="$(autostart_path)"
  if [[ ! -f "$file" ]]; then
    printf '[]\n'
    return
  fi
  local items='[]'
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    [[ "$line" =~ ^[[:space:]]*-- ]] && continue
    kind=""
    exec=""
    if [[ "$line" =~ o\.launch_on_start\([[:space:]]*\"([^\"]+)\" ]]; then
      kind="launch_on_start"
      exec="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ o\.exec_on_start\([[:space:]]*\"([^\"]+)\" ]]; then
      kind="exec_on_start"
      exec="${BASH_REMATCH[1]}"
    else
      continue
    fi
    is_relaunch_exec "$exec" && continue
    id="lua:${kind}:${exec}"
    class="$(class_for_startup_exec "$exec")"
    items="$(jq --arg id "$id" --arg source "$(basename "$file")" --arg kind "$kind" \
      --arg exec "$exec" --arg class "$class" --argjson line "$n" \
      '. + [{id: $id, source: $source, kind: $kind, exec: $exec, class: $class, line: $line}]' \
      <<<"$items")"
  done <"$file"
  printf '%s\n' "$items"
}

boot_state_json() {
  local disabled=false skip=false
  [[ -f "$(disabled_path)" ]] && disabled=true
  [[ -f "$(skip_path)" ]] && skip=true
  config_skip_once && skip=true
  jq -n --argjson disabled "$disabled" --argjson skip "$skip" \
    '{disabled: $disabled, skipOnce: $skip, active: (($disabled or $skip) | not)}'
}

build_rows() {
  local cfg startup clients
  cfg="$1"
  startup="$2"
  clients="${3:-[]}"
  jq --argjson startup "$startup" --argjson clients "$clients" "$jq_lib"'
    load_config as $cfg
    | ($cfg.ignored) as $ign
    | ([ $cfg.entries[] | {key: (.class | ascii_downcase), value: .} ] | from_entries) as $byClass
    | ([ $cfg.entries[] | {key: (.exec | ascii_downcase), value: .} ] | from_entries) as $byExec
    | [
        $cfg.entries[]
        | . as $e
        | ($startup | map(select((.class | ascii_downcase) == ($e.class | ascii_downcase)
              or (.exec | ascii_downcase) == ($e.exec | ascii_downcase))) | .[0] // null) as $s
        | {
            id: ("relaunch:" + $e.class),
            kind: (if $s != null then (if ($ign | index($s.id)) then "relaunch" else "both" end) else "relaunch" end),
            class: $e.class,
            label: $e.class,
            exec: (if $e.exec != "" then $e.exec else ($e.class | guess_exec) end),
            execSource: ($e.execSource // ""),
            workspace: $e.workspace,
            enabled: $e.enabled,
            inRelaunch: true,
            ignored: (if $s != null then (($ign | index($s.id)) != null) else false end),
            startupId: (if $s != null then $s.id else null end)
          }
      ] | sort_by(.workspace, .class) as $fromRelaunch
    | [
        $startup[]
        | . as $s
        | (
            $byClass[($s.class | ascii_downcase)]
            // $byExec[($s.exec | ascii_downcase)]
            // $byExec[($s.exec | split(" ")[0] | ascii_downcase)]
            // null
          ) as $e
        | select($e == null)
        | {
            id: $s.id,
            kind: (if ($ign | index($s.id)) then "ignored" else "startup" end),
            class: $s.class,
            label: (if $s.class != "" then $s.class else $s.exec end),
            exec: $s.exec,
            workspace: 0,
            enabled: false,
            inRelaunch: false,
            ignored: (($ign | index($s.id)) != null),
            startupId: $s.id
          }
      ] as $fromStartup
    | (
        $clients
        | map(. + {match: (if (.initialClass // "") != "" then .initialClass else (.class // "") end)})
        | map(select(.match != "" and ((.workspace.id // 0) >= 1)))
        | sort_by(.workspace.id, .match)
        | unique_by(.match)
      ) as $running
    | [
        $running[]
        | . as $c
        | select($byClass[($c.match | ascii_downcase)] == null)
        | {
            id: ("running:" + $c.match),
            kind: "running",
            class: $c.match,
            label: $c.match,
            exec: (if ($c.relaunchExec // "") != "" then $c.relaunchExec else ($c.match | guess_exec) end),
            execSource: (if ($c.relaunchExecSource // "") != "" then $c.relaunchExecSource else "guess" end),
            workspace: $c.workspace.id,
            enabled: false,
            inRelaunch: false,
            ignored: false,
            startupId: null
          }
      ] as $fromRunning
    | ($fromRunning + $fromRelaunch + $fromStartup)
  ' <<<"$cfg"
}

decorate_items() {
  local _items="$1"
  local _meta='[]'
  local _class _exec _src _ok _unverified
  while IFS=$'\t' read -r _class _exec _src; do
    [[ -n "$_class" ]] || continue
    if [[ -z "$_src" ]]; then
      if [[ -n "$(override_exec_for_class "$_class")" ]]; then
        _src="overrides-table"
      elif [[ "$_exec" == "$(printf '%s' "$_class" | tr '[:upper:]' '[:lower:]')" ]]; then
        _src="guess"
      fi
    fi
    if exec_is_ok "$_exec"; then _ok=true; else _ok=false; fi
    if [[ "$_src" == guess || "$_src" == cmdline ]]; then _unverified=true; else _unverified=false; fi
    _meta="$(jq --arg class "$_class" --arg exec "$_exec" --arg src "$_src" \
      --argjson ok "$_ok" --argjson unverified "$_unverified" '
        . + [{
          class: $class,
          exec: $exec,
          execSource: $src,
          execOk: $ok,
          unverified: $unverified
        }]
      ' <<<"$_meta")"
  done < <(jq -r '.[] | [(.class // ""), (.exec // ""), (.execSource // "")] | @tsv' <<<"$_items")
  jq --argjson meta "$_meta" '
    ($meta | map({key: .class, value: .}) | from_entries) as $by
    | map(
        . as $it
        | ($by[$it.class] // {execSource: ($it.execSource // ""), execOk: true, unverified: false}) as $m
        | .execSource = $m.execSource
        | .execOk = $m.execOk
        | .unverified = $m.unverified
      )
  ' <<<"$_items"
}

emit_state() {
  local cfg startup rows extra clients entries warnings
  ensure_overrides_file
  cfg="$(load_config_json)"
  startup="$(scan_startup)"
  clients="$(clients_json)"
  rows="$(build_rows "$cfg" "$startup" "$clients")"
  local _entf _rowf
  _entf="$(mktemp)"
  _rowf="$(mktemp)"
  decorate_items "$(jq -c '.entries' <<<"$cfg")" >"$_entf"
  decorate_items "$rows" >"$_rowf"
  entries="$(cat "$_entf")"
  rows="$(cat "$_rowf")"
  rm -f "$_entf" "$_rowf"
  if ! jq -e . >/dev/null 2>&1 <<<"$entries"; then
    entries="$(jq -c '.entries' <<<"$cfg")"
  fi
  if ! jq -e . >/dev/null 2>&1 <<<"$rows"; then
    rows='[]'
  fi
  cfg="$(jq --argjson entries "$entries" '.entries = $entries' <<<"$cfg")"
  warnings="$(jq '[.[] | select(.execOk == false) | {
    class, exec, execSource, execOk,
    message: ("command not found: " + ((.exec | split(" "))[0] // .exec))
  }]' <<<"$entries")"
  extra='{}'
  if [[ -n "${1:-}" ]]; then extra="$1"; fi
  extra="$(jq --argjson warnings "$warnings" '. + {warnings: $warnings}' <<<"$extra")"
  jq -n --argjson cfg "$cfg" --argjson startup "$startup" --argjson rows "$rows" \
    --argjson boot "$(boot_state_json)" --argjson lastBoot "$(last_boot_state_json)" \
    --argjson extra "$extra" \
    --arg snippet "$(lua_path)" --arg config "$(config_path)" \
    '{
      ok: true,
      staggerSeconds: $cfg.staggerSeconds,
      entries: $cfg.entries,
      ignored: $cfg.ignored,
      startup: $startup,
      rows: $rows,
      boot: $boot,
      lastBoot: $lastBoot,
      snippetPath: $snippet,
      configPath: $config,
      warnings: $extra.warnings
    } + $extra'
}

last_boot_state_json() {
  local p text
  p="$(last_boot_json_path)"
  if [[ ! -f "$p" ]]; then
    printf 'null\n'
    return
  fi
  text=""
  [[ -f "$(last_boot_log_path)" ]] && text="$(cat "$(last_boot_log_path)")"
  jq --arg text "$text" --arg logPath "$(last_boot_log_path)" \
    '. + {text: $text, logPath: $logPath}' "$p"
}

write_last_boot() {
  local started="$1" outcome="$2" reason="$3" launches="${4:-[]}" stagger="${5:-0}"
  local json
  mkdir -p "$(config_dir)"
  json="$(jq -n \
    --arg startedAt "$started" \
    --arg outcome "$outcome" \
    --arg reason "$reason" \
    --argjson launches "$launches" \
    --argjson stagger "$stagger" \
    '{
      startedAt: $startedAt,
      outcome: $outcome,
      reason: $reason,
      staggerSeconds: $stagger,
      launches: $launches
    }')"
  printf '%s\n' "$json" | atomic_write "$(last_boot_json_path)"
  {
    printf 'relaunch boot  %s\n' "$started"
    printf 'outcome: %s\n' "$outcome"
    [[ -n "$reason" ]] && printf 'reason:  %s\n' "$reason"
    printf 'stagger: %ss\n' "$stagger"
    if [[ "$launches" != "[]" ]]; then
      printf '\nlaunches:\n'
      jq -r '
        .[] |
        "  ws \(.workspace)  \(.class)  \(.status)  pid=\(.pid // "-")"
        + (if .actualWorkspace != null then "  landed=ws \(.actualWorkspace) class=\(.actualClass // "?")" else "" end)
        + (if .placed == false then "  MISPLACED" else "" end)
        + "  \(.exec)"
        + (if .error then "  (\(.error))" else "" end)
      ' <<<"$launches"
    fi
  } | atomic_write "$(last_boot_log_path)"
}

verify_launches() {
  local launches="$1" clients
  if [[ "${RELAUNCH_VERIFY_SLEEP:-2}" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk "BEGIN{exit !(${RELAUNCH_VERIFY_SLEEP:-2} > 0)}"; then
    sleep "${RELAUNCH_VERIFY_SLEEP:-2}"
  fi
  if ! clients="$(clients_json)"; then
    printf '%s\n' "$launches"
    return
  fi
  jq --argjson clients "$clients" '
    map(
      . as $l
      | (
          $clients
          | map(select(
              (.pid == $l.pid)
              or ((.initialClass // .class // "") == $l.class)
            ))
          | .[0] // null
        ) as $w
      | . + {
          actualClass: (if $w == null then null else ($w.initialClass // $w.class) end),
          actualWorkspace: (if $w == null then null else $w.workspace.id end),
          placed: (if $w == null then false else ($w.workspace.id == $l.workspace) end)
        }
    )
  ' <<<"$launches"
}

clients_json() {
  local out
  if ! out="$("$HYPRCTL" clients -j)"; then
    die "hyprctl clients: command failed"
  fi
  jq -e 'type == "array"' >/dev/null <<<"$out" || die "hyprctl clients: expected a JSON array"
  annotate_clients "$out"
}

cmd_save() {
  local cfg clients merged extra
  ensure_hooks
  cfg="$(load_config_json)"
  clients="$(clients_json)"
  merged="$(jq --argjson clients "$clients" "$jq_lib"' capture($clients)' <<<"$cfg")"
  jq "$jq_lib"' del(.added, .updated) | dump_config' <<<"$merged" | atomic_write "$(config_path)"
  jq "$jq_lib"' del(.added, .updated)' <<<"$merged" | write_generated
  extra="$(jq '{added: .added, updated: .updated}' <<<"$merged")"
  if $json_out; then
    emit_state "$extra"
  else
    jq -r '"Captured: \(.added) new, \(.updated) updated."' <<<"$merged"
    printf 'Rules: %s\n' "$(lua_path)"
    printf 'Run `relaunch reload` or reboot to apply.\n'
  fi
}

cmd_generate() {
  ensure_hooks
  load_config_json | write_generated
  if $json_out; then
    emit_state
  else
    printf 'Wrote %s\n' "$(lua_path)"
  fi
}

cmd_list() {
  ensure_hooks
  if $json_out; then
    emit_state
    return
  fi
  local cfg
  cfg="$(load_config_json)"
  printf 'boot: %s\n' "$(boot_state_json | jq -r 'if .disabled then "disabled" elif .skipOnce then "skip-next" else "on" end')"
  if jq -e '.entries | length == 0' >/dev/null <<<"$cfg"; then
    printf 'No relaunch entries. Run `relaunch save`.\n'
  else
    printf '%-4s %-3s %-24s %s\n' ws on class exec
    jq -r "$jq_lib"'
      .entries[]
      | [
          (.workspace | tostring),
          (if .enabled then "x" else " " end),
          .class,
          (if .exec != "" then .exec else (.class | guess_exec) + " *" end)
        ]
      | @tsv
    ' <<<"$cfg" | while IFS=$'\t' read -r ws on class exec; do
      printf '%-4s [%s] %-24s %s\n' "$ws" "$on" "$class" "$exec"
    done
  fi
  local startup
  startup="$(scan_startup)"
  if jq -e 'length > 0' >/dev/null <<<"$startup"; then
    printf '\nstartup apps (autostart.lua):\n'
    jq -r '.[] | "  [\(.kind)] \(.exec)  class=\(.class)"' <<<"$startup"
  fi
}

cmd_reload() {
  "$HYPRCTL" reload || die "hyprctl reload failed"
  if $json_out; then
    emit_state
  else
    printf 'Hyprland reloaded.\n'
  fi
}

cmd_boot() {
  # Hidden autostart hook. Never listed as a startup app.
  local started cfg stagger line class ws exec token status pid err launches first_launch
  started="$(date -Iseconds)"
  mkdir -p "$(config_dir)"
  if [[ -f "$(disabled_path)" ]]; then
    write_last_boot "$started" disabled "disabled flag present" "[]" 0
    exit 0
  fi
  if [[ -f "$(skip_path)" ]] || config_skip_once; then
    set_skip_once false
    load_config_json | write_generated
    write_last_boot "$started" skipped "skip-once consumed; rules restored for the next boot" "[]" 0
    exit 0
  fi
  cfg="$(load_config_json)"
  stagger="$(jq -r '.staggerSeconds' <<<"$cfg")"
  launches='[]'
  first_launch=true
  while IFS=$'\t' read -r class ws exec; do
    [[ -z "$exec" ]] && continue
    is_relaunch_exec "$exec" && continue
    if [[ "$stagger" =~ ^[1-9][0-9]*$ ]]; then
      if $first_launch; then
        first_launch=false
      else
        if [[ -n "${RELAUNCH_SLEEP:-}" ]]; then
          "$RELAUNCH_SLEEP" "$stagger"
        else
          sleep "$stagger"
        fi
      fi
    fi
    token="${exec%% *}"
    token="${token##*/}"
    pid=""
    err=""
    if [[ "$token" != *=* ]] && ! command -v "${exec%% *}" >/dev/null 2>&1 && [[ ! -x "${exec%% *}" ]]; then
      status="not_found"
      err="command not found: ${exec%% *}"
    else
      bash -c "$exec" &
      pid=$!
      if kill -0 "$pid" 2>/dev/null; then
        status="started"
      else
        status="failed"
        err="process exited immediately"
        pid=""
      fi
    fi
    launches="$(jq --arg class "$class" --argjson ws "$ws" --arg exec "$exec" \
      --arg status "$status" --arg pid "$pid" --arg error "$err" '
        . + [{
          class: $class,
          workspace: $ws,
          exec: $exec,
          status: $status,
          pid: (if $pid == "" then null else ($pid | tonumber) end),
          error: (if $error == "" then null else $error end)
        }]
      ' <<<"$launches")"
  done < <(jq -r "$jq_lib"'
    enabled_entries[]
    | [ .class, (.workspace | tostring), (if .exec != "" then .exec else (.class | guess_exec) end) ]
    | @tsv
  ' <<<"$cfg")
  launches="$(verify_launches "$launches")"
  write_last_boot "$started" launched "" "$launches" "$stagger"
}

cmd_last_boot() {
  local open=false a
  for a in "$@"; do
    [[ "$a" == --open ]] && open=true
  done
  if [[ ! -f "$(last_boot_log_path)" ]]; then
    die "no last-boot log yet (reboot or run: relaunch boot)"
  fi
  if $open; then
    command -v omarchy-launch-editor >/dev/null 2>&1 || die "omarchy-launch-editor not found"
    omarchy-launch-editor "$(last_boot_log_path)" &
    if $json_out; then
      emit_state
    else
      printf 'Opened %s\n' "$(last_boot_log_path)"
    fi
    return
  fi
  if $json_out; then
    last_boot_state_json
    return
  fi
  cat "$(last_boot_log_path)"
}

arg_value() {
  local flag="$1"
  shift
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "$flag" ]]; then
      printf '%s\n' "${2:-}"
      return 0
    fi
    shift
  done
  return 1
}

cmd_import() {
  local exec ws class cfg
  exec="$(arg_value --exec "$@" || true)"
  ws="$(arg_value --workspace "$@" || true)"
  [[ -n "$exec" ]] || die "import requires --exec"
  [[ "$ws" =~ ^[1-9][0-9]*$ ]] || die "import requires --workspace N (N>=1)"
  class="$(class_for_startup_exec "$exec")"
  cfg="$(load_config_json)"
  if jq -e --arg class "$class" '.entries[] | select(.class == $class)' >/dev/null <<<"$cfg"; then
    cfg="$(jq --arg class "$class" --argjson ws "$ws" --arg exec "$exec" '
      .entries |= map(if .class == $class then .workspace = $ws | .exec = $exec | .enabled = true else . end)
    ' <<<"$cfg")"
  else
    cfg="$(jq --arg class "$class" --argjson ws "$ws" --arg exec "$exec" '
      .entries += [{class: $class, workspace: $ws, exec: $exec, enabled: true}]
    ' <<<"$cfg")"
  fi
  cfg="$(jq --arg class "$class" '.entries |= map(if .class == $class then .execSource = "overrides-table" else . end)' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  set_override_exec "$class" "$exec"
  jq "$jq_lib"' load_config' <<<"$cfg" | write_generated
  if $json_out; then emit_state; else printf 'Imported %s -> workspace %s\n' "$class" "$ws"; fi
}

cmd_set_exec() {
  local class exec cfg
  class="$(arg_value --class "$@" || true)"
  exec="$(arg_value --exec "$@" || true)"
  [[ -n "$class" ]] || die "set-exec requires --class"
  [[ -n "$exec" ]] || die "set-exec requires --exec"
  cfg="$(load_config_json)"
  if ! jq -e --arg class "$class" '.entries[] | select(.class == $class)' >/dev/null <<<"$cfg"; then
    die "no relaunch entry for class: $class"
  fi
  cfg="$(jq --arg class "$class" --arg exec "$exec" '
    .entries |= map(if .class == $class then .exec = $exec | .execSource = "overrides-table" else . end)
  ' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  set_override_exec "$class" "$exec"
  jq "$jq_lib"' load_config' <<<"$cfg" | write_generated
  if $json_out; then
    emit_state
  else
    printf 'Set %s exec to %s\n' "$class" "$exec"
  fi
}

cmd_drop() {
  local class cfg
  class="$(arg_value --class "$@" || true)"
  [[ -n "$class" ]] || die "drop requires --class"
  cfg="$(load_config_json)"
  cfg="$(jq --arg class "$class" '.entries |= map(select(.class != $class))' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  jq "$jq_lib"' load_config' <<<"$cfg" | write_generated
  if $json_out; then emit_state; else printf 'Removed %s from relaunch\n' "$class"; fi
}

cmd_drop_startup() {
  local id kind exec file tmp kept=0
  id="$(arg_value --id "$@" || true)"
  [[ -n "$id" ]] || die "drop-startup requires --id"
  kind="${id#*:}"
  kind="${kind%%:*}"
  exec="${id#*:}"
  exec="${exec#*:}"
  file="$(autostart_path)"
  [[ -f "$file" ]] || die "no autostart file: $file"
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*-- ]]; then
      printf '%s\n' "$line" >>"$tmp"
      continue
    fi
    if [[ "$kind" == launch_on_start && "$line" =~ o\.launch_on_start\([[:space:]]*\"([^\"]+)\" && "${BASH_REMATCH[1]}" == "$exec" ]]; then
      kept=1
      continue
    fi
    if [[ "$kind" == exec_on_start && "$line" =~ o\.exec_on_start\([[:space:]]*\"([^\"]+)\" && "${BASH_REMATCH[1]}" == "$exec" ]]; then
      kept=1
      continue
    fi
    printf '%s\n' "$line" >>"$tmp"
  done <"$file"
  [[ "$kept" == 1 ]] || die "startup line not found: $id"
  mv -f "$tmp" "$file"
  if $json_out; then emit_state; else printf 'Deleted startup config: %s\n' "$exec"; fi
}

cmd_ignore() {
  local id cfg
  id="$(arg_value --id "$@" || true)"
  [[ -n "$id" ]] || die "ignore requires --id"
  cfg="$(load_config_json)"
  cfg="$(jq --arg id "$id" '.ignored = ((.ignored // []) + [$id] | unique)' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  if $json_out; then emit_state; else printf 'Ignoring startup config: %s\n' "$id"; fi
}

cmd_unignore() {
  local id cfg
  id="$(arg_value --id "$@" || true)"
  [[ -n "$id" ]] || die "unignore requires --id"
  cfg="$(load_config_json)"
  cfg="$(jq --arg id "$id" '.ignored = [(.ignored // [])[] | select(. != $id)]' <<<"$cfg")"
  jq "$jq_lib"' dump_config' <<<"$cfg" | atomic_write "$(config_path)"
  if $json_out; then emit_state; else printf 'No longer ignoring: %s\n' "$id"; fi
}

cmd_boot_skip() {
  set_skip_once true
  load_config_json | write_generated
  if $json_out; then emit_state; else printf 'Relaunch will skip the next boot.\n'; fi
}

cmd_boot_disable() {
  mkdir -p "$(config_dir)"
  : >"$(disabled_path)"
  set_skip_once false
  load_config_json | write_generated
  if $json_out; then emit_state; else printf 'Relaunch disabled until re-enabled.\n'; fi
}

cmd_boot_enable() {
  rm -f "$(disabled_path)"
  set_skip_once false
  load_config_json | write_generated
  if $json_out; then emit_state; else printf 'Relaunch enabled on boot.\n'; fi
}

# One-line Hyprland hook. io.open-then-dofile so a missing relaunch.lua
# (uninstall, first boot before generate) is not a Hyprland config error.
hyprland_hook_line() {
  printf '%s\n' 'local _rl = (os.getenv("XDG_CONFIG_HOME") or (os.getenv("HOME") .. "/.config")) .. "/omarchy-relaunch/relaunch.lua"; local _f = io.open(_rl); if _f then _f:close(); dofile(_rl) end'
}

remove_managed_block() {
  local file="$1" tmp
  [[ -f "$file" ]] || return 0
  tmp="$(mktemp)"
  # Drop only our marker comment and the immediately following line when
  # that line is our hook (relaunch boot) or our dofile. Never eat the next
  # user launch/source line just because it sits under the comment.
  awk '
    /^[[:space:]]*-- omarchy-relaunch/ { pending=1; next }
    pending {
      pending=0
      if ($0 ~ /relaunch boot/ || $0 ~ /omarchy-relaunch\/relaunch\.lua/) next
    }
    { print }
  ' "$file" >"$tmp"
  mv -f "$tmp" "$file"
}

cmd_uninstall() {
  local yes=false a
  for a in "$@"; do
    [[ "$a" == --yes ]] && yes=true
  done
  $yes || die "uninstall requires --yes"
  remove_managed_block "$(autostart_path)"
  remove_managed_block "$(hyprland_lua_path)"
  remove_legacy_conf
  rm -rf "$(config_dir)"
  local bin="${PREFIX:-$HOME/.local}/bin/relaunch"
  if [[ -f "$bin" ]] && grep -q 'omarchy-relaunch bar widget' "$bin"; then
    rm -f "$bin"
  fi
  # Emit the result before unlinking the plugin checkout. The bar panel
  # loads these QML files; deleting them first makes the popup vanish
  # with no "removed" message.
  if $json_out; then
    jq -n '{ok: true, uninstalled: true}'
    ( sleep 2; rm -rf "$(plugin_dir)" ) &
  else
    rm -rf "$(plugin_dir)"
    printf 'Relaunch removed.\n'
  fi
}

ensure_hooks() {
  local auto lua bin hook
  auto="$(autostart_path)"
  lua="$(hyprland_lua_path)"
  hook="$(hyprland_hook_line)"
  mkdir -p "$(dirname "$auto")" "$(config_dir)"
  ensure_overrides_file
  remove_legacy_conf
  # Create the rules file before touching hyprland.lua. Hyprland reloads
  # as soon as that file changes; dofile of a missing path is a hard error.
  [[ -f "$(lua_path)" ]] || printf 'return\n' >"$(lua_path)"
  if [[ -f "$auto" ]] && ! grep -q 'omarchy-relaunch' "$auto"; then
    {
      printf '\n'
      printf '%s\n' '-- omarchy-relaunch (managed; hidden from the Relaunch list)'
      printf '%s\n' "o.exec_on_start(\"${SELF} boot\")"
    } >>"$auto"
  fi
  if [[ -f "$lua" ]] && ! grep -Fq "$hook" "$lua"; then
    remove_managed_block "$lua"
    {
      printf '\n'
      printf '%s\n' '-- omarchy-relaunch'
      printf '%s\n' "$hook"
    } >>"$lua"
  fi

  # Plugin-manager installs do not put the script on PATH. Copy it so a
  # terminal `relaunch` works, but skip that when tests override the config dir.
  if [[ -z "${RELAUNCH_CONFIG_DIR:-}" ]]; then
    bin="${PREFIX:-$HOME/.local}/bin/relaunch"
    mkdir -p "$(dirname "$bin")"
    if [[ ! -e "$bin" ]] || ! cmp -s "$SELF" "$bin"; then
      install -m 0755 "$SELF" "$bin"
    fi
  fi
}

usage() {
  cat <<'EOF'
relaunch — engine for omarchy-relaunch

  relaunch save [--json]                 capture running layout
  relaunch generate [--json]             rebuild rules from config
  relaunch list [--json]                 relaunch + startup inventory
  relaunch reload                        hyprctl reload
  relaunch boot                          hidden autostart hook
  relaunch last-boot [--json] [--open]   show or open the last boot log
  relaunch import --exec CMD --workspace N
  relaunch set-exec --class CLASS --exec CMD
  relaunch drop --class CLASS            remove from relaunch list
  relaunch drop-startup --id ID          delete the Hyprland startup line
  relaunch ignore --id ID                leave startup alone, remember it
  relaunch unignore --id ID
  relaunch boot-skip                     skip relaunch on the next boot
  relaunch boot-disable                  disable until re-enabled
  relaunch boot-enable
  relaunch uninstall --yes               remove relaunch permanently

config:  ~/.config/omarchy-relaunch/config.json
rules:   ~/.config/omarchy-relaunch/relaunch.lua
EOF
}

main() {
  need_jq
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi
  local cmd="$1"
  shift
  if has_json_flag "$@"; then
    json_out=true
  fi
  case "$cmd" in
    save) cmd_save ;;
    generate) cmd_generate ;;
    list) cmd_list ;;
    reload) cmd_reload ;;
    boot) cmd_boot ;;
    last-boot) cmd_last_boot "$@" ;;
    import) cmd_import "$@" ;;
    set-exec) cmd_set_exec "$@" ;;
    drop) cmd_drop "$@" ;;
    drop-startup) cmd_drop_startup "$@" ;;
    ignore) cmd_ignore "$@" ;;
    unignore) cmd_unignore "$@" ;;
    boot-skip) cmd_boot_skip ;;
    boot-disable) cmd_boot_disable ;;
    boot-enable) cmd_boot_enable ;;
    uninstall) cmd_uninstall "$@" ;;
    ensure-hooks) ensure_hooks ;;
    -h | --help | help) usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
